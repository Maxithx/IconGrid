<Window x:Class="IconGrid.Views.FileCopyProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IconGrid.Views"
        Title="{Binding FastCopyProgressTitle}"
        Height="360"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#F2F3F6"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/TemplateGuidelines.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="ProgressActionButtonStyle" TargetType="Button" BasedOn="{StaticResource TemplateActionButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="MinWidth" Value="90" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource StartsideSectionCardStyle}" Padding="16">
        <StackPanel>
            <TextBlock Style="{StaticResource TemplateCardTitleStyle}"
                       MouseLeftButtonDown="Header_MouseLeftButtonDown"
                       Text="{Binding FastCopyProgressTitle}" />

            <ProgressBar Margin="0,14,0,0"
                         Height="8"
                         Minimum="0"
                         Maximum="100"
                         Value="{Binding State.Progress, RelativeSource={RelativeSource AncestorType={x:Type views:FileCopyProgressWindow}}}" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Style="{StaticResource TemplateSmallTextStyle}"
                           Text="{Binding FastCopyLiveSpeedLabel}" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                           Style="{StaticResource TemplateSmallTextStyle}"
                           Margin="12,0,0,0"
                           Text="{Binding State.LiveMiBS, RelativeSource={RelativeSource AncestorType={x:Type views:FileCopyProgressWindow}}, StringFormat={}{0:0.00} MiB/s}" />

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Style="{StaticResource TemplateSmallTextStyle}"
                           Margin="0,8,0,0"
                           Text="{Binding FastCopyAverageLabel}" />
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Style="{StaticResource TemplateSmallTextStyle}"
                           Margin="12,8,0,0"
                           Text="{Binding State.AverageMiBS, RelativeSource={RelativeSource AncestorType={x:Type views:FileCopyProgressWindow}}, StringFormat={}{0:0.00} MiB/s}" />

                <TextBlock Grid.Row="2" Grid.Column="0"
                           Style="{StaticResource TemplateSmallTextStyle}"
                           Margin="0,8,0,0"
                           Text="{Binding FastCopyPeakLabel}" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Style="{StaticResource TemplateSmallTextStyle}"
                           Margin="12,8,0,0"
                           Text="{Binding State.PeakMiBS, RelativeSource={RelativeSource AncestorType={x:Type views:FileCopyProgressWindow}}, StringFormat={}{0:0.00} MiB/s}" />

                <TextBlock Grid.Row="0" Grid.Column="2"
                           Margin="40,0,0,0"
                           Style="{StaticResource TemplateSmallTextStyle}"
                           Text="{Binding FastCopyEtaLabel}" />
                <TextBlock Grid.Row="1" Grid.Column="2"
                           Margin="40,8,0,0"
                           Style="{StaticResource TemplateSmallTextStyle}"
                           Text="{Binding State.EtaText, RelativeSource={RelativeSource AncestorType={x:Type views:FileCopyProgressWindow}}}" />

                <TextBlock Grid.Row="3" Grid.Column="0"
                           Margin="0,8,0,0"
                           Style="{StaticResource TemplateSmallTextStyle}"
                           Text="{Binding FastCopyElapsedLabel}" />
                <TextBlock Grid.Row="3" Grid.Column="2"
                           Margin="40,8,0,0"
                           Style="{StaticResource TemplateSmallTextStyle}"
                           Text="{Binding State.ElapsedText, RelativeSource={RelativeSource AncestorType={x:Type views:FileCopyProgressWindow}}}" />

                <TextBlock Grid.Row="4" Grid.Column="0"
                           Margin="0,8,0,0"
                           Style="{StaticResource TemplateSmallTextStyle}"
                           Text="{Binding FastCopyTotalSizeLabel}" />
                <TextBlock Grid.Row="4" Grid.Column="1"
                           Grid.ColumnSpan="2"
                           Margin="12,8,0,0"
                           Style="{StaticResource TemplateSmallTextStyle}"
                           Text="{Binding State.TotalSizeLabel, RelativeSource={RelativeSource AncestorType={x:Type views:FileCopyProgressWindow}}}" />

                <TextBlock Grid.Row="5" Grid.Column="0"
                           Margin="0,8,0,0"
                           Style="{StaticResource TemplateSmallTextStyle}"
                           Text="{Binding FastCopyFilesRemainingLabel}" />
                <TextBlock Grid.Row="5" Grid.Column="2"
                           Margin="40,8,0,0"
                           Style="{StaticResource TemplateSmallTextStyle}"
                           Text="{Binding State.FilesRemainingLabel, RelativeSource={RelativeSource AncestorType={x:Type views:FileCopyProgressWindow}}}" />
            </Grid>

            <Button Style="{StaticResource ProgressActionButtonStyle}"
                    Margin="0,14,0,0"
                    Content="{Binding FastCopyCancelButton}"
                    Click="CancelButton_Click" />
        </StackPanel>
    </Border>
</Window>