<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- ============================================================
         DESIGN TOKENS — color palette (single source of truth).
         Use these x:Key brushes in styles so one change propagates
         everywhere in the launcher/settings UI. The full contract is
         documented in TemplateGuidelines.xaml -> "Color palette".
         Dark  = used when IsLightTheme=False.
         Light = used when IsLightTheme=True.
         ============================================================ -->
    <!-- Card / page surfaces -->
    <SolidColorBrush x:Key="SurfaceFillDarkBrush" Color="#323232" />
    <SolidColorBrush x:Key="SurfaceFillLightBrush" Color="#F3F4F7" />
    <SolidColorBrush x:Key="SurfaceBorderDarkBrush" Color="#3A3A3A" />
    <SolidColorBrush x:Key="SurfaceBorderLightBrush" Color="#D1D5DB" />
    <!-- Scrollbars -->
    <SolidColorBrush x:Key="ScrollTrackDarkBrush" Color="#323232" />
    <SolidColorBrush x:Key="ScrollTrackLightBrush" Color="#F0F2F5" />
    <SolidColorBrush x:Key="ScrollThumbDarkBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="ScrollThumbLightBrush" Color="#CBD5E1" />
    <!-- Dropdowns (ComboBox) — light surface on purpose, NOT white,
         so dark text is always readable in both themes. -->
    <SolidColorBrush x:Key="ComboBoxSurfaceBrush" Color="#F3F4F7" />
    <SolidColorBrush x:Key="ComboBoxTextBrush" Color="#1F2937" />
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="ComboBoxHoverBorderBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="ComboBoxHighlightBrush" Color="#E5E7EB" />
    <!-- Comma-separated text fallback used by navigation buttons -->
    <SolidColorBrush x:Key="SettingsTextFallbackBrush" Color="#FF3F3F46" />

    <!-- Legacy brushes (kept for backward compatibility; new styles should
         use the DESIGN TOKENS above). -->
    <SolidColorBrush x:Key="StartsideLightCardFill" Color="#F3F4F7" />
    <SolidColorBrush x:Key="StartsideCardFill" Color="#323232" />
    <SolidColorBrush x:Key="SettingsPageScrollBarTrackDarkBrush" Color="#323232" />
    <SolidColorBrush x:Key="SettingsPageScrollBarTrackLightBrush" Color="#F0F2F5" />
    <SolidColorBrush x:Key="SettingsPageScrollBarThumbDarkBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="SettingsPageScrollBarThumbLightBrush" Color="#CBD5E1" />
    <Style x:Key="StartsideCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource StartsideCardFill}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>
    <Style x:Key="StartsidePanelStyle" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Effect" Value="{x:Null}" />
    </Style>
    <Style x:Key="StartsideSectionCardStyle" TargetType="Border" BasedOn="{StaticResource StartsideCardStyle}">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="28" />
        <Setter Property="Margin" Value="0,0,0,5" />
        <Setter Property="Background" Value="{StaticResource StartsideCardFill}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#3A3A3A" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                <Setter Property="Background" Value="{StaticResource StartsideLightCardFill}" />
                <Setter Property="BorderBrush" Value="#D1D5DB" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="SettingsPageScrollBarRepeatButtonStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SettingsPageScrollBarThumbStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder"
                            Width="5"
                            Margin="3,4"
                            HorizontalAlignment="Center"
                            Background="{StaticResource SettingsPageScrollBarThumbDarkBrush}"
                            CornerRadius="3"
                            Opacity="0.78" />
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource SettingsPageScrollBarThumbLightBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Width" Value="7" />
                            <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.95" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Width" Value="7" />
                            <Setter TargetName="ThumbBorder" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SettingsPageScrollBarStyle" TargetType="ScrollBar">
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="TrackBackground"
                                Background="{StaticResource SettingsPageScrollBarTrackDarkBrush}"
                                CornerRadius="6"
                                Opacity="0.72" />
                        <Track x:Name="PART_Track"
                               IsDirectionReversed="True"
                               IsEnabled="{TemplateBinding IsEnabled}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineUpCommand"
                                              Style="{StaticResource SettingsPageScrollBarRepeatButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SettingsPageScrollBarThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineDownCommand"
                                              Style="{StaticResource SettingsPageScrollBarRepeatButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter TargetName="TrackBackground" Property="Background" Value="{StaticResource SettingsPageScrollBarTrackLightBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TrackBackground" Property="Opacity" Value="0.9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SettingsPageScrollBarThumbHorizontalStyle" TargetType="Thumb">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbBorder"
                            Height="5"
                            Margin="4,3"
                            VerticalAlignment="Center"
                            Background="{StaticResource SettingsPageScrollBarThumbDarkBrush}"
                            CornerRadius="3"
                            Opacity="0.78" />
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource SettingsPageScrollBarThumbLightBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Height" Value="7" />
                            <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.95" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Height" Value="7" />
                            <Setter TargetName="ThumbBorder" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SettingsPageScrollBarHorizontalStyle" TargetType="ScrollBar" BasedOn="{StaticResource SettingsPageScrollBarStyle}">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Height" Value="12" />
        <Setter Property="MinHeight" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="TrackBackground"
                                Background="{StaticResource SettingsPageScrollBarTrackDarkBrush}"
                                CornerRadius="6"
                                Opacity="0.72" />
                        <Track x:Name="PART_Track"
                               IsDirectionReversed="False"
                               IsEnabled="{TemplateBinding IsEnabled}">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineLeftCommand"
                                              Style="{StaticResource SettingsPageScrollBarRepeatButtonStyle}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SettingsPageScrollBarThumbHorizontalStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineRightCommand"
                                              Style="{StaticResource SettingsPageScrollBarRepeatButtonStyle}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                            <Setter TargetName="TrackBackground" Property="Background" Value="{StaticResource SettingsPageScrollBarTrackLightBrush}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="TrackBackground" Property="Opacity" Value="0.9" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Fixed dropdown width shared by the Game Resolution section dropdowns.
         The fixed grid contract: every dropdown in that section uses this exact
         width + height + baseline so they align perfectly with each other. -->
    <sys:Double x:Key="SettingsDropdownWidth">220</sys:Double>

    <!-- Shared ComboBox style for settings dropdowns. Fixed Width/Height from
         SettingsDropdownWidth guarantee identical size + baseline. Use with the
         SharedSizeGroup column pattern in lists/rows.

         IMPORTANT: we deliberately use WPF's STANDARD ComboBox template here (no
         custom ControlTemplate). The default template opens the list in a true
         HWND popup that ALWAYS floats above other content (e.g. the Up/Select all/
         Clear selection buttons below the From/To dropdowns) and reliably opens
         even inside a ScrollViewer page. A custom Popup-based template produced
         z-order/clipping problems - that is why the list appeared behind the
         buttons and only showed a sliver.

         Readability is handled by ComboBoxItemContainerStyle: every item gets the
         light ComboBoxSurfaceBrush background + dark ComboBoxTextBrush text in
         BOTH themes, so the expanded list looks like the token-driven surface
         while the popup itself is WPF's proven HWND window. -->
    <Style x:Key="ComboBoxItemContainerStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource ComboBoxTextBrush}" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Row"
                            Background="{StaticResource ComboBoxSurfaceBrush}"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource ComboBoxHighlightBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Row" Property="Background" Value="{StaticResource ComboBoxHighlightBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TemplateComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Width" Value="{StaticResource SettingsDropdownWidth}" />
        <Setter Property="MinWidth" Value="{StaticResource SettingsDropdownWidth}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Foreground" Value="{StaticResource ComboBoxTextBrush}" />
        <Setter Property="Background" Value="{StaticResource ComboBoxSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource ComboBoxBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItemContainerStyle}" />
    </Style>

    <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="32" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="{Binding DataContext.ToggleStatePrefixText, RelativeSource={RelativeSource AncestorType=Window}}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="Normal"
                                   Width="46"
                                   TextAlignment="Left"
                                   Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Margin="0,0,6,0" />
                        <TextBlock x:Name="StateSuffix"
                                   Grid.Column="1"
                                   Width="32"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   FontWeight="Normal"
                                   Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Margin="0,0,12,0"
                                   TextAlignment="Left"
                                   Text="{Binding DataContext.ToggleStateOffText, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Border x:Name="Track"
                                Grid.Column="2"
                                Width="40"
                                Height="20"
                                CornerRadius="10"
                                Background="#F5F6F8"
                                BorderBrush="#C5CBD9"
                                BorderThickness="1"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                SnapsToDevicePixels="True"
                                Padding="2">
                            <Ellipse x:Name="Thumb"
                                     Width="14"
                                     Height="14"
                                     Fill="#5A5A5A"
                                     HorizontalAlignment="Left"
                                     VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="#0F000000" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Fill" Value="White" />
                            <Setter TargetName="StateSuffix"
                                    Property="Text"
                                    Value="{Binding DataContext.ToggleStateOnText, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="StateSuffix"
                                    Property="Text"
                                    Value="{Binding DataContext.ToggleStateOffText, RelativeSource={RelativeSource AncestorType=Window}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Track" Property="Background" Value="#8A8E9B" />
                            <Setter TargetName="Thumb" Property="Fill" Value="#5A5A5A" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="#7C818D" />
                            <Setter TargetName="StateSuffix" Property="Foreground" Value="#7A8293" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <SolidColorBrush x:Key="SliderTrackBackground" Color="#1C2237" />
    <Style x:Key="SliderTrackRepeatButtonStyle" TargetType="RepeatButton">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="4" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="2"
                            Height="{TemplateBinding Height}"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SliderThumbStyle" TargetType="Thumb">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Width="16"
                            Height="16"
                            CornerRadius="8"
                            Background="White"
                            BorderBrush="#E5E7EB"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8"
                                              ShadowDepth="2"
                                              Color="#22000000"
                                              Opacity="0.35" />
                        </Border.Effect>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ModernSliderStyle" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderTrackRepeatButtonStyle}"
                                              Background="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource SliderThumbStyle}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource SliderTrackRepeatButtonStyle}"
                                              Background="{StaticResource SliderTrackBackground}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
