<Window x:Class="IconGrid.Views.GamingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:IconGrid.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="IconGrid Gaming Overlay"
        Width="720"
        Height="44"
        MinWidth="720"
        MinHeight="44"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="White"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                             CornerRadius="0"
                             GlassFrameThickness="0"
                             NonClientFrameEdges="None"
                             ResizeBorderThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <!--
        Window shell only: lifetime, DPI/display handling, scale and placement.
        The overlay visuals live in GamingOverlayBar so the settings page can host
        the exact same control as a read-only preview.
    -->
    <views:GamingOverlayBar x:Name="OverlayBar" />
</Window>
