<UserControl x:Class="IconGrid.Views.GamingOverlayBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:IconGrid.Helpers"
             xmlns:skin="clr-namespace:IconGrid.Helpers.Skin"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
        Visual part of the gaming overlay (monitor row + settings/scale popups).
        This control is purely visual: every event handler is wired by the host
        (GamingOverlayWindow) so the exact same visuals can also be hosted as a
        read-only preview on the Gaming overlay settings page.
    -->
    <UserControl.Resources>
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
        <helpers:PingSeverityToBrushConverter x:Key="PingSeverityBrush" />
        <helpers:PercentToHeightConverter x:Key="PercentToHeightConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="MonitorHighPingColor" Color="#FFF87171" />
        <SolidColorBrush x:Key="OverlayCloseHoverDark" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="OverlayClosePressedDark" Color="#21FFFFFF" />
        <SolidColorBrush x:Key="OverlayMenuBorderBrush" Color="#33FFFFFF" />
        <!--
            The gaming overlay always uses its own skin (never the Windows/app theme). All colours,
            the fonts and the corner radius come from MainViewModel.GamingOverlaySkin, which the
            Skin Studio page edits. Layout (slots, order, spacing, scale) is owned by the monitor
            row settings and is never part of a skin.
        -->

        <Style x:Key="MonitorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding GamingOverlaySkin.TextBrush}" />
            <Setter Property="FontFamily" Value="{Binding GamingOverlaySkin.FontFamily}" />
            <Setter Property="FontWeight" Value="{Binding GamingOverlaySkin.FontWeightValue}" />
            <Setter Property="FontSize" Value="{Binding GamingOverlaySkin.FontSizeValue}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding DataContext.GamingOverlayTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OverlayDividerStyle" TargetType="Border">
            <Setter Property="Width" Value="{Binding GamingOverlaySkin.DividerWidthValue}" />
            <Setter Property="Height" Value="{Binding GamingOverlaySkin.DividerHeightValue}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{Binding GamingOverlaySkin.DividerBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <!-- Without Aliased edge mode a 1 DIP line lands on half device pixels at 125%/150%
                 scaling, so some dividers rendered 1 px and others 2 px wide. -->
            <Setter Property="RenderOptions.EdgeMode" Value="Aliased" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="{Binding DataContext.GamingOverlayTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NetworkMonitorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MonitorTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SystemMonitor.IsHighPing}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource MonitorHighPingColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OverlayFpsTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MonitorTextStyle}">
            <Setter Property="FontFamily" Value="{Binding GamingOverlaySkin.MonoFontFamily}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{Binding GamingOverlaySkin.MonoFontSizeValue}" />
            <Setter Property="Foreground" Value="{Binding GamingOverlaySkin.AccentBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding DataContext.GamingOverlayTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OverlayCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{Binding GamingOverlaySkin.ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{Binding GamingOverlaySkin.ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{Binding GamingOverlaySkin.TextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding GamingOverlaySkin.ButtonCornerRadiusValue}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource OverlayCloseHoverDark}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource OverlayClosePressedDark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding DataContext.GamingOverlayTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OverlayToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{Binding GamingOverlaySkin.ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{Binding GamingOverlaySkin.ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{Binding GamingOverlaySkin.TextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding GamingOverlaySkin.ButtonCornerRadiusValue}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource OverlayCloseHoverDark}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource OverlayClosePressedDark}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource OverlayClosePressedDark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding DataContext.GamingOverlayTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!--
            Module templates. Each template root takes the view model as DataContext (the block
            itself only carries configuration), so the existing skin styles keep working and the
            templates can bind to SystemMonitor directly. The block TYPE is chosen by
            OverlayBlockTemplateSelector.
        -->
        <DataTemplate x:Key="OverlayClockBlockTemplate">
            <TextBlock Style="{StaticResource MonitorTextStyle}" Margin="0,0,9,0"
                       DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <Run Text="{Binding SystemMonitor.ClockText, Mode=OneWay}" />
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="OverlayPingBlockTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,6,0"
                        Background="{Binding SystemMonitor.PingSeverityLevel, Converter={StaticResource PingSeverityBrush}}" />
                <TextBlock Style="{StaticResource NetworkMonitorTextStyle}" Margin="0,0,9,0">
                    <Run Text="{Binding MonitorNetworkLabel, Mode=OneWay}" />
                    <Run Text=": " />
                    <Run Text="{Binding SystemMonitor.NetworkStatus, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="OverlayGaugeCpuBlockTemplate">
            <Border Background="{Binding GamingOverlaySkin.ChipBackgroundBrush}"
                    BorderBrush="{Binding GamingOverlaySkin.ChipBorderBrush}"
                    BorderThickness="{Binding GamingOverlaySkin.ChipBorderThickness}"
                    CornerRadius="{Binding GamingOverlaySkin.ChipCornerRadiusValue}"
                    Padding="{Binding GamingOverlaySkin.ChipPaddingThickness}"
                    Margin="0,0,9,0" VerticalAlignment="Center"
                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource MonitorTextStyle}" Margin="0,0,6,0">
                        <Run Text="{Binding MonitorCpuLabel, Mode=OneWay}" />
                        <Run Text=": " />
                        <Run Text="{Binding SystemMonitor.CpuTemp, Mode=OneWay}" />
                    </TextBlock>
                    <Border Width="12" Height="14" Background="#22000000"
                            BorderBrush="{Binding GamingOverlaySkin.CpuMeterBorderBrush}"
                            BorderThickness="1" CornerRadius="2">
                        <Grid ClipToBounds="True">
                            <Rectangle Fill="{Binding GamingOverlaySkin.CpuMeterBrush}"
                                       HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                       RadiusX="2" RadiusY="2"
                                       Height="{Binding SystemMonitor.CpuUsagePercent, Converter={StaticResource PercentToHeightConverter}, ConverterParameter=12}" />
                            <Border Background="{Binding GamingOverlaySkin.MeterSegmentsBrush}" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="OverlayGaugeGpuBlockTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <Border Background="{Binding GamingOverlaySkin.ChipBackgroundBrush}"
                        BorderBrush="{Binding GamingOverlaySkin.ChipBorderBrush}"
                        BorderThickness="{Binding GamingOverlaySkin.ChipBorderThickness}"
                        CornerRadius="{Binding GamingOverlaySkin.ChipCornerRadiusValue}"
                        Padding="{Binding GamingOverlaySkin.ChipPaddingThickness}"
                        Margin="0,0,9,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource MonitorTextStyle}" Margin="0,0,6,0">
                            <Run Text="{Binding MonitorGpuLabel, Mode=OneWay}" />
                            <Run Text=": " />
                            <Run Text="{Binding SystemMonitor.GpuTemp, Mode=OneWay}" />
                        </TextBlock>
                        <Border Width="12" Height="14" Background="#22000000"
                                BorderBrush="{Binding GamingOverlaySkin.GpuMeterBorderBrush}"
                                BorderThickness="1" CornerRadius="2">
                            <Grid ClipToBounds="True">
                                <Rectangle Fill="{Binding GamingOverlaySkin.GpuMeterBrush}"
                                           HorizontalAlignment="Stretch" VerticalAlignment="Bottom"
                                           RadiusX="2" RadiusY="2"
                                           Height="{Binding SystemMonitor.GpuUsagePercent, Converter={StaticResource PercentToHeightConverter}, ConverterParameter=12}" />
                                <Border Background="{Binding GamingOverlaySkin.MeterSegmentsBrush}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
                <Border Width="2" Height="14" Margin="0,0,9,0" VerticalAlignment="Center"
                        Background="{Binding GamingOverlaySkin.GpuAccentLineBrush}"
                        Visibility="{Binding GamingOverlaySkin.HasGpuAccentLine, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="OverlayStatGpuClockBlockTemplate">
            <TextBlock Style="{StaticResource MonitorTextStyle}" Width="58" Margin="0,0,9,0" TextAlignment="Right"
                       DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <Run Text="{Binding SystemMonitor.GpuClock, Mode=OneWay}" />
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="OverlayStatFrameTimeBlockTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,9,0" VerticalAlignment="Center"
                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <TextBlock Style="{StaticResource MonitorTextStyle}" Text="FT: " VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource MonitorTextStyle}" Width="46" TextAlignment="Left" VerticalAlignment="Center">
                    <Run Text="{Binding SystemMonitor.FrameTimeDisplay, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="OverlayStatFpsBlockTemplate">
            <Grid Width="54" Margin="0,0,10,0" VerticalAlignment="Center"
                  DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource MonitorTextStyle}" Text="FPS:"
                           VerticalAlignment="Center" TextAlignment="Right" />
                <TextBlock Grid.Column="1" Style="{StaticResource OverlayFpsTextStyle}"
                           Text="{Binding SystemMonitor.FpsStatus, Mode=OneWay}"
                           VerticalAlignment="Center" Margin="-2,0,0,0" TextAlignment="Right"
                           Effect="{Binding GamingOverlaySkin.AccentGlowEffect}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OverlayDividerBlockTemplate">
            <Border Style="{StaticResource OverlayDividerStyle}"
                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        </DataTemplate>

        <skin:OverlayBlockTemplateSelector x:Key="OverlayBlockTemplateSelector"
                                              Clock="{StaticResource OverlayClockBlockTemplate}"
                                              Ping="{StaticResource OverlayPingBlockTemplate}"
                                              GaugeCpu="{StaticResource OverlayGaugeCpuBlockTemplate}"
                                              GaugeGpu="{StaticResource OverlayGaugeGpuBlockTemplate}"
                                              StatGpuClock="{StaticResource OverlayStatGpuClockBlockTemplate}"
                                              StatFrameTime="{StaticResource OverlayStatFrameTimeBlockTemplate}"
                                              StatFps="{StaticResource OverlayStatFpsBlockTemplate}"
                                              Divider="{StaticResource OverlayDividerBlockTemplate}" />
    </UserControl.Resources>

    <Grid>
        <Grid HorizontalAlignment="Right"
              VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="OverlayRoot"
                    Grid.Row="0"
                    BorderThickness="0"
                    CornerRadius="{Binding GamingOverlaySkin.CornerRadiusValue}"
                    Padding="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{Binding GamingOverlaySkin.BarBackgroundBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Height="{Binding GamingOverlayBackgroundHeight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2"
                            Background="{Binding GamingOverlaySkin.BackgroundImageBrush}"
                            Opacity="{Binding GamingOverlaySkin.BackgroundImageOpacity}"
                            Visibility="{Binding GamingOverlaySkin.HasBackgroundImage, Converter={StaticResource BoolToVisibility}}" />
                    <Border Grid.ColumnSpan="2"
                            Background="{Binding GamingOverlaySkin.BackgroundTintBrush}"
                            Opacity="{Binding GamingOverlaySkin.BackgroundTintOpacity}" />
                    <Border Grid.ColumnSpan="2"
                            Background="{Binding GamingOverlaySkin.PatternBrush}"
                            Opacity="{Binding GamingOverlaySkin.PatternOpacity}"
                            Visibility="{Binding GamingOverlaySkin.HasPattern, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="14,0,0,0">
                        <Border VerticalAlignment="Stretch"
                                Margin="0,0,10,0"
                                Padding="10,2"
                                Background="{Binding GamingOverlaySkin.PatternBrush}"
                                BorderBrush="{Binding GamingOverlaySkin.CalloutAccentBrush}"
                                BorderThickness="0,0,1,0"
                                Visibility="{Binding GamingOverlaySkin.HasCalloutTag, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding GamingOverlaySkin.CalloutTopText}"
                                               FontFamily="{Binding GamingOverlaySkin.FontFamily}"
                                               FontWeight="Bold"
                                               FontSize="{Binding GamingOverlaySkin.FontSizeValue}"
                                               Foreground="{Binding GamingOverlaySkin.TextBrush}"
                                               VerticalAlignment="Center" />
                                    <Ellipse Width="6" Height="6"
                                             Margin="3,0,0,0"
                                             VerticalAlignment="Center"
                                             Fill="{Binding GamingOverlaySkin.CalloutAccentBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding GamingOverlaySkin.CalloutBottomText}"
                                           FontFamily="{Binding GamingOverlaySkin.FontFamily}"
                                           FontWeight="Bold"
                                           FontSize="9"
                                           Foreground="{Binding GamingOverlaySkin.CalloutAccentBrush}" />
                            </StackPanel>
                        </Border>

                        <Border VerticalAlignment="Center"
                                Margin="0,0,10,0"
                                Padding="8,0"
                                CornerRadius="2"
                                Background="#1A00FF66"
                                BorderBrush="{Binding GamingOverlaySkin.BrandBrush}"
                                BorderThickness="0,0,2,0"
                                Visibility="{Binding GamingOverlaySkin.HasBrand, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding GamingOverlaySkin.BrandText}"
                                       FontFamily="{Binding GamingOverlaySkin.FontFamily}"
                                       FontWeight="Bold"
                                       FontSize="{Binding GamingOverlaySkin.BrandFontSizeValue}"
                                       Foreground="{Binding GamingOverlaySkin.BrandBrush}"
                                       VerticalAlignment="Center"
                                       Effect="{Binding GamingOverlaySkin.AccentGlowEffect}" />
                        </Border>

                        <Image MaxHeight="{Binding GamingOverlayBackgroundHeight}"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Stretch="Uniform"
                               Width="{Binding GamingOverlaySkin.LogoWidthValue}"
                               Source="{Binding GamingOverlaySkin.LogoImageSource}"
                               Visibility="{Binding GamingOverlaySkin.HasLogo, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding GamingOverlayLayoutBlocks}"
                                      ItemTemplateSelector="{StaticResource OverlayBlockTemplateSelector}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Opacity" Value="{Binding OpacityValue}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,2,0">
                        <ToggleButton x:Name="SettingsMenuButton"
                                      Style="{StaticResource OverlayToggleButtonStyle}"
                                      Width="36"
                                      Height="32"
                                      Margin="0,0,-4,0"
                                      Padding="0"
                                      ToolTip="Overlay settings">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE713;"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </ToggleButton>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource OverlayCloseButtonStyle}"
                                Width="44"
                                Height="32"
                                Padding="0"
                                VerticalAlignment="Center"
                                ToolTip="Close">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8BB;"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="PopupPanelsRow"
                  Grid.Row="1"
                  HorizontalAlignment="Right"
                  Margin="0,8,0,0"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="244" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="244" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ScalePopupPanel"
                        Grid.Column="0"
                        Visibility="Collapsed"
                        Padding="12"
                        BorderBrush="{StaticResource OverlayMenuBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{Binding GamingOverlaySkin.CornerRadiusValue}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{Binding GamingOverlaySkin.PopupBackgroundBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Overlay scale"
                                   FontWeight="SemiBold"
                                   Style="{StaticResource MonitorTextStyle}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="PopupScaleSlider"
                                    Minimum="1.0"
                                    Maximum="1.5"
                                    TickFrequency="0.05"
                                    SmallChange="0.05"
                                    LargeChange="0.10"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding GamingOverlayUiScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource ModernSliderStyle}" />
                            <TextBlock Grid.Column="1"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MonitorTextStyle}"
                                       Text="{Binding GamingOverlayUiScale, StringFormat={}{0:P0}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="12"
                        BorderBrush="{StaticResource OverlayMenuBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{Binding GamingOverlaySkin.CornerRadiusValue}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{Binding GamingOverlaySkin.PopupBackgroundBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Button Style="{StaticResource OverlayCloseButtonStyle}"
                                x:Name="ScaleMenuButton"
                                Height="34"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="Overlay scale"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource OverlayCloseButtonStyle}"
                                x:Name="OpenSettingsButton"
                                Height="34"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="Open gaming overlay settings"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
