<UserControl x:Class="IconGrid.Views.GamingOverlayBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:IconGrid.Helpers"
             xmlns:skin="clr-namespace:IconGrid.Helpers.Skin"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
        Visual part of the gaming overlay (monitor row + settings/scale popups).
        This control is purely visual: every event handler is wired by the host
        (GamingOverlayWindow) so the exact same visuals can also be hosted as a
        read-only preview on the Gaming overlay settings page.
    -->
    <UserControl.Resources>
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
        <helpers:PingSeverityToBrushConverter x:Key="PingSeverityBrush" />
        <helpers:PercentToHeightConverter x:Key="PercentToHeightConverter" />
        <helpers:PercentToLengthConverter x:Key="PercentToLength" />
        <helpers:PercentToArcGeometryConverter x:Key="PercentToArcGeometry" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="MonitorHighPingColor" Color="#FFF87171" />
        <SolidColorBrush x:Key="OverlayCloseHoverDark" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="OverlayClosePressedDark" Color="#21FFFFFF" />
        <SolidColorBrush x:Key="OverlayMenuBorderBrush" Color="#33FFFFFF" />
        <!--
            The gaming overlay always uses its own skin (never the Windows/app theme). All colours,
            the fonts and the corner radius come from MainViewModel.GamingOverlaySkin, which the
            Skin Studio page edits. Layout (slots, order, spacing, scale) is owned by the monitor
            row settings and is never part of a skin.
        -->

        <Style x:Key="MonitorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding GamingOverlaySkin.TextBrush}" />
            <Setter Property="FontFamily" Value="{Binding GamingOverlaySkin.FontFamily}" />
            <Setter Property="FontWeight" Value="{Binding GamingOverlaySkin.FontWeightValue}" />
            <Setter Property="FontSize" Value="{Binding GamingOverlaySkin.FontSizeValue}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding DataContext.GamingOverlayTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OverlayDividerStyle" TargetType="Border">
            <Setter Property="Width" Value="{Binding GamingOverlaySkin.DividerWidthValue}" />
            <Setter Property="Height" Value="{Binding GamingOverlaySkin.DividerHeightValue}" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{Binding GamingOverlaySkin.DividerBrush}" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <!-- Without Aliased edge mode a 1 DIP line lands on half device pixels at 125%/150%
                 scaling, so some dividers rendered 1 px and others 2 px wide. -->
            <Setter Property="RenderOptions.EdgeMode" Value="Aliased" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="{Binding DataContext.GamingOverlayTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NetworkMonitorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MonitorTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SystemMonitor.IsHighPing}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource MonitorHighPingColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OverlayFpsTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MonitorTextStyle}">
            <Setter Property="FontFamily" Value="{Binding GamingOverlaySkin.MonoFontFamily}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="{Binding GamingOverlaySkin.MonoFontSizeValue}" />
            <Setter Property="Foreground" Value="{Binding GamingOverlaySkin.AccentBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding DataContext.GamingOverlayTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OverlayCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{Binding GamingOverlaySkin.ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{Binding GamingOverlaySkin.ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{Binding GamingOverlaySkin.TextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding GamingOverlaySkin.ButtonCornerRadiusValue}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource OverlayCloseHoverDark}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource OverlayClosePressedDark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding DataContext.GamingOverlayTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OverlayToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="{Binding GamingOverlaySkin.ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{Binding GamingOverlaySkin.ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{Binding GamingOverlaySkin.TextBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{Binding GamingOverlaySkin.ButtonCornerRadiusValue}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource OverlayCloseHoverDark}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource OverlayClosePressedDark}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource OverlayClosePressedDark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding DataContext.GamingOverlayTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!--
            Module templates. Each template root takes the view model as DataContext (the block
            itself only carries configuration), so the existing skin styles keep working and the
            templates can bind to SystemMonitor directly. The block TYPE is chosen by
            OverlayBlockTemplateSelector.
        -->
        <DataTemplate x:Key="OverlayClockBlockTemplate">
            <TextBlock Style="{StaticResource MonitorTextStyle}" Margin="0,0,9,0"
                       DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <Run Text="{Binding SystemMonitor.ClockText, Mode=OneWay}" />
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="OverlayPingBlockTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center" Margin="0,0,6,0"
                        Background="{Binding SystemMonitor.PingSeverityLevel, Converter={StaticResource PingSeverityBrush}}" />
                <TextBlock Style="{StaticResource NetworkMonitorTextStyle}" Margin="0,0,9,0">
                    <Run Text="{Binding MonitorNetworkLabel, Mode=OneWay}" />
                    <Run Text=": " />
                    <Run Text="{Binding SystemMonitor.NetworkStatus, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!--
            Gauge blocks (CPU / GPU usage). The DataContext here is the OverlayBlock, so every
            per-module prop (label, meter style, colour, size, temp/percent toggles) drives the
            look. Skin colours and telemetry are reached through the hosting ItemsControl, which
            keeps one template usable for both the overlay and the Skin Studio canvas.
        -->
        <Style x:Key="OverlayMeterTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{Binding DataContext.GamingOverlaySkin.TextBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
            <Setter Property="FontFamily" Value="{Binding DataContext.GamingOverlaySkin.FontFamily, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
            <Setter Property="FontWeight" Value="{Binding DataContext.GamingOverlaySkin.FontWeightValue, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
            <Setter Property="FontSize" Value="{Binding DataContext.GamingOverlaySkin.FontSizeValue, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding DataContext.GamingOverlayTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="OverlayGaugeBarBlockTemplate">
            <Grid VerticalAlignment="Center">
                <StackPanel x:Name="CpuGroup" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{Binding DataContext.GamingOverlaySkin.ChipBackgroundBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            BorderBrush="{Binding DataContext.GamingOverlaySkin.ChipBorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            BorderThickness="{Binding DataContext.GamingOverlaySkin.ChipBorderThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CornerRadius="{Binding DataContext.GamingOverlaySkin.ChipCornerRadiusValue, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Padding="{Binding DataContext.GamingOverlaySkin.ChipPaddingThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Margin="0,0,9,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,6,0"
                                       Text="{Binding DisplayLabel, Mode=OneWay, StringFormat={}{0}:}" />
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,6,0"
                                       Visibility="{Binding ShowTemp, Converter={StaticResource BoolToVisibility}}"
                                       Text="{Binding DataContext.SystemMonitor.CpuTemp, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,6,0"
                                       Visibility="{Binding ShowPercent, Converter={StaticResource BoolToVisibility}}"
                                       Text="{Binding DataContext.SystemMonitor.CpuUsagePercent, RelativeSource={RelativeSource AncestorType=ItemsControl}, StringFormat={}{0:0}%}" />
                            <Border Width="{Binding MeterWidthValue}" Height="{Binding MeterHeightValue}"
                                    Background="#22000000"
                                    BorderBrush="{Binding DataContext.GamingOverlaySkin.CpuMeterBorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    BorderThickness="1" CornerRadius="2">
                                <Grid ClipToBounds="True">
                                    <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Fill" Value="{Binding DataContext.GamingOverlaySkin.CpuMeterBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasMeterColor}" Value="True">
                                                        <Setter Property="Fill" Value="{Binding MeterBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                        <Rectangle.Height>
                                            <MultiBinding Converter="{StaticResource PercentToLength}">
                                                <Binding Path="DataContext.SystemMonitor.CpuUsagePercent" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                <Binding Path="MeterHeightValue" />
                                            </MultiBinding>
                                        </Rectangle.Height>
                                    </Rectangle>
                                    <Border Background="{Binding DataContext.GamingOverlaySkin.MeterSegmentsBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Visibility="{Binding HasGrid, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="GpuGroup" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Background="{Binding DataContext.GamingOverlaySkin.ChipBackgroundBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            BorderBrush="{Binding DataContext.GamingOverlaySkin.ChipBorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            BorderThickness="{Binding DataContext.GamingOverlaySkin.ChipBorderThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CornerRadius="{Binding DataContext.GamingOverlaySkin.ChipCornerRadiusValue, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Padding="{Binding DataContext.GamingOverlaySkin.ChipPaddingThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Margin="0,0,9,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,6,0"
                                       Text="{Binding DisplayLabel, Mode=OneWay, StringFormat={}{0}:}" />
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,6,0"
                                       Visibility="{Binding ShowTemp, Converter={StaticResource BoolToVisibility}}"
                                       Text="{Binding DataContext.SystemMonitor.GpuTemp, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,6,0"
                                       Visibility="{Binding ShowPercent, Converter={StaticResource BoolToVisibility}}"
                                       Text="{Binding DataContext.SystemMonitor.GpuUsagePercent, RelativeSource={RelativeSource AncestorType=ItemsControl}, StringFormat={}{0:0}%}" />
                            <Border Width="{Binding MeterWidthValue}" Height="{Binding MeterHeightValue}"
                                    Background="#22000000"
                                    BorderBrush="{Binding DataContext.GamingOverlaySkin.GpuMeterBorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    BorderThickness="1" CornerRadius="2">
                                <Grid ClipToBounds="True">
                                    <Rectangle HorizontalAlignment="Stretch" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2">
                                        <Rectangle.Style>
                                            <Style TargetType="Rectangle">
                                                <Setter Property="Fill" Value="{Binding DataContext.GamingOverlaySkin.GpuMeterBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasMeterColor}" Value="True">
                                                        <Setter Property="Fill" Value="{Binding MeterBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Rectangle.Style>
                                        <Rectangle.Height>
                                            <MultiBinding Converter="{StaticResource PercentToLength}">
                                                <Binding Path="DataContext.SystemMonitor.GpuUsagePercent" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                <Binding Path="MeterHeightValue" />
                                            </MultiBinding>
                                        </Rectangle.Height>
                                    </Rectangle>
                                    <Border Background="{Binding DataContext.GamingOverlaySkin.MeterSegmentsBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Visibility="{Binding HasGrid, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                            </Border>
                            <Border Width="2" Height="14" Margin="0,0,9,0" VerticalAlignment="Center"
                                    Background="{Binding DataContext.GamingOverlaySkin.GpuAccentLineBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    Visibility="{Binding DataContext.GamingOverlaySkin.HasGpuAccentLine, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsGpu}" Value="True">
                    <Setter TargetName="GpuGroup" Property="Visibility" Value="Visible" />
                    <Setter TargetName="CpuGroup" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="OverlayGaugeRingBlockTemplate">
            <Grid VerticalAlignment="Center">
                <StackPanel x:Name="CpuGroup" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{Binding DataContext.GamingOverlaySkin.ChipBackgroundBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            BorderBrush="{Binding DataContext.GamingOverlaySkin.ChipBorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            BorderThickness="{Binding DataContext.GamingOverlaySkin.ChipBorderThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CornerRadius="{Binding DataContext.GamingOverlaySkin.ChipCornerRadiusValue, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Padding="{Binding DataContext.GamingOverlaySkin.ChipPaddingThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Margin="0,0,9,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,6,0"
                                       Text="{Binding DisplayLabel, Mode=OneWay, StringFormat={}{0}:}" />
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,6,0"
                                       Visibility="{Binding ShowTemp, Converter={StaticResource BoolToVisibility}}"
                                       Text="{Binding DataContext.SystemMonitor.CpuTemp, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,6,0"
                                       Visibility="{Binding ShowPercent, Converter={StaticResource BoolToVisibility}}"
                                       Text="{Binding DataContext.SystemMonitor.CpuUsagePercent, RelativeSource={RelativeSource AncestorType=ItemsControl}, StringFormat={}{0:0}%}" />
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse Stroke="{Binding DataContext.GamingOverlaySkin.CpuMeterBorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         StrokeThickness="2" />
                                <Path Width="16" Height="16" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Stroke" Value="{Binding DataContext.GamingOverlaySkin.CpuMeterBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMeterColor}" Value="True">
                                                    <Setter Property="Stroke" Value="{Binding MeterBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                    <Path.Data>
                                        <Binding Path="DataContext.SystemMonitor.CpuUsagePercent"
                                                 RelativeSource="{RelativeSource AncestorType=ItemsControl}"
                                                 Converter="{StaticResource PercentToArcGeometry}"
                                                 ConverterParameter="16" />
                                    </Path.Data>
                                </Path>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="GpuGroup" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Background="{Binding DataContext.GamingOverlaySkin.ChipBackgroundBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            BorderBrush="{Binding DataContext.GamingOverlaySkin.ChipBorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            BorderThickness="{Binding DataContext.GamingOverlaySkin.ChipBorderThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CornerRadius="{Binding DataContext.GamingOverlaySkin.ChipCornerRadiusValue, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Padding="{Binding DataContext.GamingOverlaySkin.ChipPaddingThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Margin="0,0,9,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,6,0"
                                       Text="{Binding DisplayLabel, Mode=OneWay, StringFormat={}{0}:}" />
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,6,0"
                                       Visibility="{Binding ShowTemp, Converter={StaticResource BoolToVisibility}}"
                                       Text="{Binding DataContext.SystemMonitor.GpuTemp, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,6,0"
                                       Visibility="{Binding ShowPercent, Converter={StaticResource BoolToVisibility}}"
                                       Text="{Binding DataContext.SystemMonitor.GpuUsagePercent, RelativeSource={RelativeSource AncestorType=ItemsControl}, StringFormat={}{0:0}%}" />
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse Stroke="{Binding DataContext.GamingOverlaySkin.GpuMeterBorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                         StrokeThickness="2" />
                                <Path Width="16" Height="16" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Stroke" Value="{Binding DataContext.GamingOverlaySkin.GpuMeterBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasMeterColor}" Value="True">
                                                    <Setter Property="Stroke" Value="{Binding MeterBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                    <Path.Data>
                                        <Binding Path="DataContext.SystemMonitor.GpuUsagePercent"
                                                 RelativeSource="{RelativeSource AncestorType=ItemsControl}"
                                                 Converter="{StaticResource PercentToArcGeometry}"
                                                 ConverterParameter="16" />
                                    </Path.Data>
                                </Path>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsGpu}" Value="True">
                    <Setter TargetName="GpuGroup" Property="Visibility" Value="Visible" />
                    <Setter TargetName="CpuGroup" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="OverlayGaugeSegmentsBlockTemplate">
            <Grid VerticalAlignment="Center">
                <StackPanel x:Name="CpuGroup" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{Binding DataContext.GamingOverlaySkin.ChipBackgroundBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            BorderBrush="{Binding DataContext.GamingOverlaySkin.ChipBorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            BorderThickness="{Binding DataContext.GamingOverlaySkin.ChipBorderThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CornerRadius="{Binding DataContext.GamingOverlaySkin.ChipCornerRadiusValue, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Padding="{Binding DataContext.GamingOverlaySkin.ChipPaddingThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Margin="0,0,9,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,6,0"
                                       Text="{Binding DisplayLabel, Mode=OneWay, StringFormat={}{0}:}" />
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,6,0"
                                       Visibility="{Binding ShowTemp, Converter={StaticResource BoolToVisibility}}"
                                       Text="{Binding DataContext.SystemMonitor.CpuTemp, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,6,0"
                                       Visibility="{Binding ShowPercent, Converter={StaticResource BoolToVisibility}}"
                                       Text="{Binding DataContext.SystemMonitor.CpuUsagePercent, RelativeSource={RelativeSource AncestorType=ItemsControl}, StringFormat={}{0:0}%}" />
                            <Border Width="{Binding MeterWidthValue}" Height="{Binding MeterHeightValue}"
                                    Background="#22000000" ClipToBounds="True"
                                    BorderBrush="{Binding DataContext.GamingOverlaySkin.CpuMeterBorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    BorderThickness="1" CornerRadius="2">
                                <Grid ClipToBounds="True">
                                    <Border HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{Binding DataContext.GamingOverlaySkin.CpuMeterBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasMeterColor}" Value="True">
                                                        <Setter Property="Background" Value="{Binding MeterBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentToLength}">
                                                <Binding Path="DataContext.SystemMonitor.CpuUsagePercent" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                <Binding Path="MeterWidthValue" />
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <DrawingBrush TileMode="Tile" Viewport="0,0,5,6" ViewportUnits="Absolute" Stretch="None">
                                                <DrawingBrush.Drawing>
                                                    <GeometryDrawing Brush="#40000000">
                                                        <GeometryDrawing.Geometry>
                                                            <RectangleGeometry Rect="4,0,1,6" />
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="GpuGroup" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Background="{Binding DataContext.GamingOverlaySkin.ChipBackgroundBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            BorderBrush="{Binding DataContext.GamingOverlaySkin.ChipBorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            BorderThickness="{Binding DataContext.GamingOverlaySkin.ChipBorderThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CornerRadius="{Binding DataContext.GamingOverlaySkin.ChipCornerRadiusValue, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Padding="{Binding DataContext.GamingOverlaySkin.ChipPaddingThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Margin="0,0,9,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,6,0"
                                       Text="{Binding DisplayLabel, Mode=OneWay, StringFormat={}{0}:}" />
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,6,0"
                                       Visibility="{Binding ShowTemp, Converter={StaticResource BoolToVisibility}}"
                                       Text="{Binding DataContext.SystemMonitor.GpuTemp, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" />
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,6,0"
                                       Visibility="{Binding ShowPercent, Converter={StaticResource BoolToVisibility}}"
                                       Text="{Binding DataContext.SystemMonitor.GpuUsagePercent, RelativeSource={RelativeSource AncestorType=ItemsControl}, StringFormat={}{0:0}%}" />
                            <Border Width="{Binding MeterWidthValue}" Height="{Binding MeterHeightValue}"
                                    Background="#22000000" ClipToBounds="True"
                                    BorderBrush="{Binding DataContext.GamingOverlaySkin.GpuMeterBorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    BorderThickness="1" CornerRadius="2">
                                <Grid ClipToBounds="True">
                                    <Border HorizontalAlignment="Left">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{Binding DataContext.GamingOverlaySkin.GpuMeterBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasMeterColor}" Value="True">
                                                        <Setter Property="Background" Value="{Binding MeterBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.Width>
                                            <MultiBinding Converter="{StaticResource PercentToLength}">
                                                <Binding Path="DataContext.SystemMonitor.GpuUsagePercent" RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                <Binding Path="MeterWidthValue" />
                                            </MultiBinding>
                                        </Border.Width>
                                    </Border>
                                    <Rectangle>
                                        <Rectangle.Fill>
                                            <DrawingBrush TileMode="Tile" Viewport="0,0,5,6" ViewportUnits="Absolute" Stretch="None">
                                                <DrawingBrush.Drawing>
                                                    <GeometryDrawing Brush="#40000000">
                                                        <GeometryDrawing.Geometry>
                                                            <RectangleGeometry Rect="4,0,1,6" />
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingBrush.Drawing>
                                            </DrawingBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsGpu}" Value="True">
                    <Setter TargetName="GpuGroup" Property="Visibility" Value="Visible" />
                    <Setter TargetName="CpuGroup" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate x:Key="OverlayGaugeTextBlockTemplate">
            <Grid VerticalAlignment="Center">
                <StackPanel x:Name="CpuGroup" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="{Binding DataContext.GamingOverlaySkin.ChipBackgroundBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            BorderBrush="{Binding DataContext.GamingOverlaySkin.ChipBorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            BorderThickness="{Binding DataContext.GamingOverlaySkin.ChipBorderThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CornerRadius="{Binding DataContext.GamingOverlaySkin.ChipCornerRadiusValue, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Padding="{Binding DataContext.GamingOverlaySkin.ChipPaddingThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Margin="0,0,9,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,4,0"
                                       Text="{Binding DisplayLabel, Mode=OneWay}" />
                            <TextBlock Margin="0,0,6,0"
                                       Text="{Binding DataContext.SystemMonitor.CpuUsagePercent, RelativeSource={RelativeSource AncestorType=ItemsControl}, StringFormat={}{0:0}%}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource OverlayMeterTextStyle}">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMeterColor}" Value="True">
                                                <Setter Property="Foreground" Value="{Binding MeterBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}"
                                       Visibility="{Binding ShowTemp, Converter={StaticResource BoolToVisibility}}"
                                       Text="{Binding DataContext.SystemMonitor.CpuTemp, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel x:Name="GpuGroup" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                    <Border Background="{Binding DataContext.GamingOverlaySkin.ChipBackgroundBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            BorderBrush="{Binding DataContext.GamingOverlaySkin.ChipBorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            BorderThickness="{Binding DataContext.GamingOverlaySkin.ChipBorderThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CornerRadius="{Binding DataContext.GamingOverlaySkin.ChipCornerRadiusValue, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Padding="{Binding DataContext.GamingOverlaySkin.ChipPaddingThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            Margin="0,0,9,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,4,0"
                                       Text="{Binding DisplayLabel, Mode=OneWay}" />
                            <TextBlock Margin="0,0,6,0"
                                       Text="{Binding DataContext.SystemMonitor.GpuUsagePercent, RelativeSource={RelativeSource AncestorType=ItemsControl}, StringFormat={}{0:0}%}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource OverlayMeterTextStyle}">
                                        <Setter Property="FontWeight" Value="Bold" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasMeterColor}" Value="True">
                                                <Setter Property="Foreground" Value="{Binding MeterBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Style="{StaticResource OverlayMeterTextStyle}"
                                       Visibility="{Binding ShowTemp, Converter={StaticResource BoolToVisibility}}"
                                       Text="{Binding DataContext.SystemMonitor.GpuTemp, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsGpu}" Value="True">
                    <Setter TargetName="GpuGroup" Property="Visibility" Value="Visible" />
                    <Setter TargetName="CpuGroup" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- Temperature-only module: one chip with the CPU or GPU temperature. -->
        <DataTemplate x:Key="OverlayTempBlockTemplate">
            <Grid VerticalAlignment="Center">
                <Border x:Name="CpuGroup"
                        Background="{Binding DataContext.GamingOverlaySkin.ChipBackgroundBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        BorderBrush="{Binding DataContext.GamingOverlaySkin.ChipBorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        BorderThickness="{Binding DataContext.GamingOverlaySkin.ChipBorderThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CornerRadius="{Binding DataContext.GamingOverlaySkin.ChipCornerRadiusValue, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        Padding="{Binding DataContext.GamingOverlaySkin.ChipPaddingThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        Margin="0,0,9,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,6,0"
                                   Text="{Binding DisplayLabel, Mode=OneWay, StringFormat={}{0}:}" />
                        <TextBlock Style="{StaticResource OverlayMeterTextStyle}"
                                   Text="{Binding DataContext.SystemMonitor.CpuTemp, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" />
                    </StackPanel>
                </Border>
                <Border x:Name="GpuGroup" Visibility="Collapsed"
                        Background="{Binding DataContext.GamingOverlaySkin.ChipBackgroundBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        BorderBrush="{Binding DataContext.GamingOverlaySkin.ChipBorderBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        BorderThickness="{Binding DataContext.GamingOverlaySkin.ChipBorderThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CornerRadius="{Binding DataContext.GamingOverlaySkin.ChipCornerRadiusValue, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        Padding="{Binding DataContext.GamingOverlaySkin.ChipPaddingThickness, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        Margin="0,0,9,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource OverlayMeterTextStyle}" Margin="0,0,6,0"
                                   Text="{Binding DisplayLabel, Mode=OneWay, StringFormat={}{0}:}" />
                        <TextBlock Style="{StaticResource OverlayMeterTextStyle}"
                                   Text="{Binding DataContext.SystemMonitor.GpuTemp, RelativeSource={RelativeSource AncestorType=ItemsControl}, Mode=OneWay}" />
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsGpu}" Value="True">
                    <Setter TargetName="GpuGroup" Property="Visibility" Value="Visible" />
                    <Setter TargetName="CpuGroup" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="OverlayStatGpuClockBlockTemplate">
            <TextBlock Style="{StaticResource MonitorTextStyle}" Width="58" Margin="0,0,9,0" TextAlignment="Right"
                       DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <Run Text="{Binding SystemMonitor.GpuClock, Mode=OneWay}" />
            </TextBlock>
        </DataTemplate>

        <DataTemplate x:Key="OverlayStatFrameTimeBlockTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,9,0" VerticalAlignment="Center"
                        DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <TextBlock Style="{StaticResource MonitorTextStyle}" Text="FT: " VerticalAlignment="Center" />
                <TextBlock Style="{StaticResource MonitorTextStyle}" Width="46" TextAlignment="Left" VerticalAlignment="Center">
                    <Run Text="{Binding SystemMonitor.FrameTimeDisplay, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="OverlayStatFpsBlockTemplate">
            <Grid Width="54" Margin="0,0,10,0" VerticalAlignment="Center"
                  DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="30" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource MonitorTextStyle}" Text="FPS:"
                           VerticalAlignment="Center" TextAlignment="Right" />
                <TextBlock Grid.Column="1" Style="{StaticResource OverlayFpsTextStyle}"
                           Text="{Binding SystemMonitor.FpsStatus, Mode=OneWay}"
                           VerticalAlignment="Center" Margin="-2,0,0,0" TextAlignment="Right"
                           Effect="{Binding GamingOverlaySkin.AccentGlowEffect}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="OverlayDividerBlockTemplate">
            <Border Style="{StaticResource OverlayDividerStyle}"
                    DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
        </DataTemplate>

        <skin:OverlayBlockTemplateSelector x:Key="OverlayBlockTemplateSelector"
                                              Clock="{StaticResource OverlayClockBlockTemplate}"
                                              Ping="{StaticResource OverlayPingBlockTemplate}"
                                              GaugeBar="{StaticResource OverlayGaugeBarBlockTemplate}"
                                              GaugeRing="{StaticResource OverlayGaugeRingBlockTemplate}"
                                              GaugeSegments="{StaticResource OverlayGaugeSegmentsBlockTemplate}"
                                              GaugeText="{StaticResource OverlayGaugeTextBlockTemplate}"
                                              StatGpuClock="{StaticResource OverlayStatGpuClockBlockTemplate}"
                                              StatFrameTime="{StaticResource OverlayStatFrameTimeBlockTemplate}"
                                              StatFps="{StaticResource OverlayStatFpsBlockTemplate}"
                                              Temp="{StaticResource OverlayTempBlockTemplate}"
                                              Divider="{StaticResource OverlayDividerBlockTemplate}" />
    </UserControl.Resources>

    <Grid>
        <Grid HorizontalAlignment="Right"
              VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="OverlayRoot"
                    Grid.Row="0"
                    BorderThickness="0"
                    CornerRadius="{Binding GamingOverlaySkin.CornerRadiusValue}"
                    Padding="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{Binding GamingOverlaySkin.BarBackgroundBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Height="{Binding GamingOverlayBackgroundHeight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2"
                            Background="{Binding GamingOverlaySkin.BackgroundImageBrush}"
                            Opacity="{Binding GamingOverlaySkin.BackgroundImageOpacity}"
                            Visibility="{Binding GamingOverlaySkin.HasBackgroundImage, Converter={StaticResource BoolToVisibility}}" />
                    <Border Grid.ColumnSpan="2"
                            Background="{Binding GamingOverlaySkin.BackgroundTintBrush}"
                            Opacity="{Binding GamingOverlaySkin.BackgroundTintOpacity}" />
                    <Border Grid.ColumnSpan="2"
                            Background="{Binding GamingOverlaySkin.PatternBrush}"
                            Opacity="{Binding GamingOverlaySkin.PatternOpacity}"
                            Visibility="{Binding GamingOverlaySkin.HasPattern, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="14,0,0,0">
                        <Border VerticalAlignment="Stretch"
                                Margin="0,0,10,0"
                                Padding="10,2"
                                Background="{Binding GamingOverlaySkin.PatternBrush}"
                                BorderBrush="{Binding GamingOverlaySkin.CalloutAccentBrush}"
                                BorderThickness="0,0,1,0"
                                Visibility="{Binding GamingOverlaySkin.HasCalloutTag, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding GamingOverlaySkin.CalloutTopText}"
                                               FontFamily="{Binding GamingOverlaySkin.FontFamily}"
                                               FontWeight="Bold"
                                               FontSize="{Binding GamingOverlaySkin.FontSizeValue}"
                                               Foreground="{Binding GamingOverlaySkin.TextBrush}"
                                               VerticalAlignment="Center" />
                                    <Ellipse Width="6" Height="6"
                                             Margin="3,0,0,0"
                                             VerticalAlignment="Center"
                                             Fill="{Binding GamingOverlaySkin.CalloutAccentBrush}" />
                                </StackPanel>
                                <TextBlock Text="{Binding GamingOverlaySkin.CalloutBottomText}"
                                           FontFamily="{Binding GamingOverlaySkin.FontFamily}"
                                           FontWeight="Bold"
                                           FontSize="9"
                                           Foreground="{Binding GamingOverlaySkin.CalloutAccentBrush}" />
                            </StackPanel>
                        </Border>

                        <Border VerticalAlignment="Center"
                                Margin="0,0,10,0"
                                Padding="8,0"
                                CornerRadius="2"
                                Background="#1A00FF66"
                                BorderBrush="{Binding GamingOverlaySkin.BrandBrush}"
                                BorderThickness="0,0,2,0"
                                Visibility="{Binding GamingOverlaySkin.HasBrand, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Text="{Binding GamingOverlaySkin.BrandText}"
                                       FontFamily="{Binding GamingOverlaySkin.FontFamily}"
                                       FontWeight="Bold"
                                       FontSize="{Binding GamingOverlaySkin.BrandFontSizeValue}"
                                       Foreground="{Binding GamingOverlaySkin.BrandBrush}"
                                       VerticalAlignment="Center"
                                       Effect="{Binding GamingOverlaySkin.AccentGlowEffect}" />
                        </Border>

                        <Image MaxHeight="{Binding GamingOverlayBackgroundHeight}"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               Stretch="Uniform"
                               Width="{Binding GamingOverlaySkin.LogoWidthValue}"
                               Source="{Binding GamingOverlaySkin.LogoImageSource}"
                               Visibility="{Binding GamingOverlaySkin.HasLogo, Converter={StaticResource BoolToVisibility}}" />
                        <ItemsControl ItemsSource="{Binding GamingOverlayLayoutBlocks}"
                                      ItemTemplateSelector="{StaticResource OverlayBlockTemplateSelector}"
                                      VerticalAlignment="Center">
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Opacity" Value="{Binding OpacityValue}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,12,0">
                        <ToggleButton x:Name="SettingsMenuButton"
                                      Style="{StaticResource OverlayToggleButtonStyle}"
                                      Width="{Binding GamingOverlaySettingsButton.ButtonWidthValue}"
                                      Height="{Binding GamingOverlaySettingsButton.ButtonHeightValue}"
                                      Opacity="{Binding GamingOverlaySettingsButton.OpacityValue}"
                                      Margin="0,0,4,0"
                                      Padding="0"
                                      ToolTip="Overlay settings">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="{Binding GamingOverlaySettingsButton.ButtonGlyph}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GamingOverlaySettingsButton.HasColor}" Value="True">
                                                <Setter Property="Foreground" Value="{Binding GamingOverlaySettingsButton.ColorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </ToggleButton>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource OverlayCloseButtonStyle}"
                                Width="{Binding GamingOverlayCloseButton.ButtonWidthValue}"
                                Height="{Binding GamingOverlayCloseButton.ButtonHeightValue}"
                                Opacity="{Binding GamingOverlayCloseButton.OpacityValue}"
                                Padding="0"
                                VerticalAlignment="Center"
                                ToolTip="Close">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="{Binding GamingOverlayCloseButton.ButtonGlyph}"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding GamingOverlayCloseButton.HasColor}" Value="True">
                                                <Setter Property="Foreground" Value="{Binding GamingOverlayCloseButton.ColorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="PopupPanelsRow"
                  Grid.Row="1"
                  HorizontalAlignment="Right"
                  Margin="0,8,0,0"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="244" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="244" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ScalePopupPanel"
                        Grid.Column="0"
                        Visibility="Collapsed"
                        Padding="12"
                        BorderBrush="{StaticResource OverlayMenuBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{Binding GamingOverlaySkin.CornerRadiusValue}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{Binding GamingOverlaySkin.PopupBackgroundBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Overlay scale"
                                   FontWeight="SemiBold"
                                   Style="{StaticResource MonitorTextStyle}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="PopupScaleSlider"
                                    Minimum="1.0"
                                    Maximum="1.5"
                                    TickFrequency="0.05"
                                    SmallChange="0.05"
                                    LargeChange="0.10"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding GamingOverlayUiScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource ModernSliderStyle}" />
                            <TextBlock Grid.Column="1"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MonitorTextStyle}"
                                       Text="{Binding GamingOverlayUiScale, StringFormat={}{0:P0}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="12"
                        BorderBrush="{StaticResource OverlayMenuBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{Binding GamingOverlaySkin.CornerRadiusValue}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{Binding GamingOverlaySkin.PopupBackgroundBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Button Style="{StaticResource OverlayCloseButtonStyle}"
                                x:Name="ScaleMenuButton"
                                Height="34"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="Overlay scale"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource OverlayCloseButtonStyle}"
                                x:Name="OpenSettingsButton"
                                Height="34"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="Open gaming overlay settings"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
