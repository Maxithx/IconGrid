<UserControl x:Class="IconGrid.Views.GamingOverlayBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:IconGrid.Helpers"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
        Visual part of the gaming overlay (monitor row + settings/scale popups).
        This control is purely visual: every event handler is wired by the host
        (GamingOverlayWindow) so the exact same visuals can also be hosted as a
        read-only preview on the Gaming overlay settings page.
    -->
    <UserControl.Resources>
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
        <helpers:PingSeverityToBrushConverter x:Key="PingSeverityBrush" />
        <helpers:PercentToHeightConverter x:Key="PercentToHeightConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <SolidColorBrush x:Key="MonitorHighPingColor" Color="#FFF87171" />
        <SolidColorBrush x:Key="OverlayFpsBrush" Color="#7CFF6B" />
        <SolidColorBrush x:Key="OverlayFpsLightBrush" Color="#16A34A" />
        <SolidColorBrush x:Key="OverlayCloseHoverLight" Color="#1A000000" />
        <SolidColorBrush x:Key="OverlayClosePressedLight" Color="#33000000" />
        <SolidColorBrush x:Key="OverlayCloseHoverDark" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="OverlayClosePressedDark" Color="#21FFFFFF" />
        <SolidColorBrush x:Key="OverlayMenuBorderBrush" Color="#33FFFFFF" />

        <Style x:Key="MonitorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#111" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding DataContext.GamingOverlayTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MonitorDividerStyle" TargetType="TextBlock" BasedOn="{StaticResource MonitorTextStyle}">
            <Setter Property="Text" Value="|" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style x:Key="NetworkMonitorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MonitorTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SystemMonitor.IsHighPing}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource MonitorHighPingColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OverlayFpsTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MonitorTextStyle}">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource OverlayFpsBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource OverlayFpsLightBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding DataContext.GamingOverlayTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OverlayCloseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource OverlayCloseHoverLight}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource OverlayClosePressedLight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="2">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{StaticResource OverlayCloseHoverDark}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{StaticResource OverlayClosePressedDark}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding DataContext.GamingOverlayTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OverlayToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource OverlayCloseHoverLight}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource OverlayClosePressedLight}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource OverlayClosePressedLight}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsDarkTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border x:Name="Root"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="2">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{StaticResource OverlayCloseHoverDark}" />
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{StaticResource OverlayClosePressedDark}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="{StaticResource OverlayClosePressedDark}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="{Binding DataContext.GamingOverlayTextBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid HorizontalAlignment="Right"
              VerticalAlignment="Top">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="OverlayRoot"
                    Grid.Row="0"
                    BorderThickness="0"
                    CornerRadius="8"
                    Padding="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{Binding DataContext.TopBarBackground, RelativeSource={RelativeSource AncestorType=Window}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter Property="Background" Value="Transparent" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Height="{Binding GamingOverlayBackgroundHeight}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="14,0,0,0">
                        <TextBlock Style="{StaticResource MonitorTextStyle}"
                                   Margin="0,0,9,0"
                                   Visibility="{Binding GamingOverlayShowClock, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="{Binding SystemMonitor.ClockText, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource MonitorDividerStyle}"
                                   Visibility="{Binding GamingOverlayDividerClockNetworkVisible, Converter={StaticResource BoolToVisibility}}" />
                        <Border Width="10"
                                Height="10"
                                CornerRadius="5"
                                VerticalAlignment="Center"
                                Margin="0,0,6,0"
                                Visibility="{Binding GamingOverlayShowNetwork, Converter={StaticResource BoolToVisibility}}"
                                Background="{Binding SystemMonitor.PingSeverityLevel, Converter={StaticResource PingSeverityBrush}}" />
                        <TextBlock Style="{StaticResource NetworkMonitorTextStyle}"
                                   Margin="0,0,9,0"
                                   Visibility="{Binding GamingOverlayShowNetwork, Converter={StaticResource BoolToVisibility}}"
                                   ToolTipService.IsEnabled="{Binding ShowDevOverlay, Converter={StaticResource InverseBoolConverter}}">
                            <Run Text="{Binding MonitorNetworkLabel, Mode=OneWay}" />
                            <Run Text=": " />
                            <Run Text="{Binding SystemMonitor.NetworkStatus, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource MonitorDividerStyle}"
                                   Visibility="{Binding GamingOverlayDividerNetworkCpuVisible, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource MonitorTextStyle}"
                                   Margin="0,0,9,0"
                                   TextAlignment="Right"
                                   Visibility="{Binding GamingOverlayShowCpu, Converter={StaticResource BoolToVisibility}}"
                                   ToolTipService.IsEnabled="{Binding ShowDevOverlay, Converter={StaticResource InverseBoolConverter}}">
                            <Run Text="{Binding MonitorCpuLabel, Mode=OneWay}" />
                            <Run Text=": " />
                            <Run Text="{Binding SystemMonitor.CpuTemp, Mode=OneWay}" />
                        </TextBlock>
                        <Border Width="12"
                                Height="14"
                                Margin="0,0,9,0"
                                Visibility="{Binding GamingOverlayShowCpu, Converter={StaticResource BoolToVisibility}}"
                                Background="#22000000"
                                BorderBrush="#80FFFFFF"
                                BorderThickness="1"
                                CornerRadius="2"
                                ToolTip="{Binding SystemMonitor.CpuUsage}">
                            <Rectangle Fill="#22C55E"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Bottom"
                                       RadiusX="2"
                                       RadiusY="2"
                                       Height="{Binding SystemMonitor.CpuUsagePercent, Converter={StaticResource PercentToHeightConverter}, ConverterParameter=12}" />
                        </Border>
                        <TextBlock Style="{StaticResource MonitorDividerStyle}"
                                   Visibility="{Binding GamingOverlayDividerCpuGpuVisible, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource MonitorTextStyle}"
                                   Margin="0,0,9,0"
                                   TextAlignment="Right"
                                   Visibility="{Binding GamingOverlayShowGpu, Converter={StaticResource BoolToVisibility}}"
                                   ToolTip="{Binding SystemMonitor.GpuName}"
                                   ToolTipService.IsEnabled="{Binding ShowDevOverlay, Converter={StaticResource InverseBoolConverter}}">
                            <Run Text="{Binding MonitorGpuLabel, Mode=OneWay}" />
                            <Run Text=": " />
                            <Run Text="{Binding SystemMonitor.GpuTemp, Mode=OneWay}" />
                        </TextBlock>
                        <Border Width="12"
                                Height="14"
                                Margin="0,0,9,0"
                                Visibility="{Binding GamingOverlayShowGpu, Converter={StaticResource BoolToVisibility}}"
                                Background="#22000000"
                                BorderBrush="#80FFFFFF"
                                BorderThickness="1"
                                CornerRadius="2"
                                ToolTip="{Binding SystemMonitor.GpuUsage}">
                            <Rectangle Fill="#A855F7"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Bottom"
                                       RadiusX="2"
                                       RadiusY="2"
                                       Height="{Binding SystemMonitor.GpuUsagePercent, Converter={StaticResource PercentToHeightConverter}, ConverterParameter=12}" />
                        </Border>
                        <TextBlock Style="{StaticResource MonitorTextStyle}"
                                   Width="58"
                                   Margin="0,0,9,0"
                                   TextAlignment="Right"
                                   Visibility="{Binding GamingOverlayGpuClockVisible, Converter={StaticResource BoolToVisibility}}">
                            <Run Text="{Binding SystemMonitor.GpuClock, Mode=OneWay}" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource MonitorDividerStyle}"
                                   Visibility="{Binding GamingOverlayDividerGpuFpsVisible, Converter={StaticResource BoolToVisibility}}" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,9,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding GamingOverlayFrameTimeVisible, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource MonitorTextStyle}"
                                       Text="FT: "
                                       VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource MonitorTextStyle}"
                                       Width="46"
                                       TextAlignment="Left"
                                       VerticalAlignment="Center"><Run Text="{Binding SystemMonitor.FrameTimeStatus, Mode=OneWay}" /><Run Text="ms" /></TextBlock>
                        </StackPanel>
                        <Grid Width="54"
                              Margin="0,0,10,0"
                              VerticalAlignment="Center"
                              Visibility="{Binding GamingOverlayShowFps, Converter={StaticResource BoolToVisibility}}"
                              ToolTipService.IsEnabled="{Binding ShowDevOverlay, Converter={StaticResource InverseBoolConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Style="{StaticResource MonitorTextStyle}"
                                       Text="FPS:"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right" />
                            <TextBlock Grid.Column="1"
                                       Style="{StaticResource OverlayFpsTextStyle}"
                                       Text="{Binding SystemMonitor.FpsStatus, Mode=OneWay}"
                                       VerticalAlignment="Center"
                                       Margin="-2,0,0,0"
                                       TextAlignment="Right" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,2,0">
                        <ToggleButton x:Name="SettingsMenuButton"
                                      Style="{StaticResource OverlayToggleButtonStyle}"
                                      Width="36"
                                      Height="32"
                                      Margin="0,0,-4,0"
                                      Padding="0"
                                      ToolTip="Overlay settings">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE713;"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </ToggleButton>
                        <Button x:Name="CloseButton"
                                Style="{StaticResource OverlayCloseButtonStyle}"
                                Width="44"
                                Height="32"
                                Padding="0"
                                VerticalAlignment="Center"
                                ToolTip="Close">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8BB;"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid x:Name="PopupPanelsRow"
                  Grid.Row="1"
                  HorizontalAlignment="Right"
                  Margin="0,8,0,0"
                  Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="244" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="244" />
                </Grid.ColumnDefinitions>

                <Border x:Name="ScalePopupPanel"
                        Grid.Column="0"
                        Visibility="Collapsed"
                        Padding="12"
                        BorderBrush="{StaticResource OverlayMenuBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{Binding DataContext.TopBarBackground, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Overlay scale"
                                   FontWeight="SemiBold"
                                   Style="{StaticResource MonitorTextStyle}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="PopupScaleSlider"
                                    Minimum="1.0"
                                    Maximum="1.5"
                                    TickFrequency="0.05"
                                    SmallChange="0.05"
                                    LargeChange="0.10"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding GamingOverlayUiScale, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource ModernSliderStyle}" />
                            <TextBlock Grid.Column="1"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource MonitorTextStyle}"
                                       Text="{Binding GamingOverlayUiScale, StringFormat={}{0:P0}}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="12"
                        BorderBrush="{StaticResource OverlayMenuBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{Binding DataContext.TopBarBackground, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.GamingOverlayTransparentBackgroundEffective, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Background" Value="Transparent" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <Button Style="{StaticResource OverlayCloseButtonStyle}"
                                x:Name="ScaleMenuButton"
                                Height="34"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="Overlay scale"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                        <Button Style="{StaticResource OverlayCloseButtonStyle}"
                                x:Name="OpenSettingsButton"
                                Height="34"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Stretch">
                            <TextBlock Text="Open gaming overlay settings"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
