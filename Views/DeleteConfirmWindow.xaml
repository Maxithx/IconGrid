<Window x:Class="IconGrid.Views.DeleteConfirmWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding FastCopyDeleteConfirmTitle}"
        Height="210"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Background="#F2F3F6"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/TemplateGuidelines.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="DeleteActionButtonStyle" TargetType="Button" BasedOn="{StaticResource TemplateActionButtonStyle}">
                <Setter Property="MinWidth" Value="88" />
                <Setter Property="Margin" Value="8,0,0,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource StartsideSectionCardStyle}" Padding="16">
        <StackPanel>
            <TextBlock Style="{StaticResource TemplateCardTitleStyle}"
                       Text="{Binding FastCopyDeleteConfirmTitle}" />
            <TextBlock Style="{StaticResource TemplateHeroBodyStyle}"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       Text="{Binding Message, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button Style="{StaticResource DeleteActionButtonStyle}"
                        Content="{Binding FastCopyDeleteYesButton}"
                        Click="Delete_Click" />
                <Button Style="{StaticResource DeleteActionButtonStyle}"
                        Content="{Binding FastCopyDeleteNoButton}"
                        Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>