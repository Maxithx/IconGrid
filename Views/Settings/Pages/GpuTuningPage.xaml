<UserControl x:Class="IconGrid.Views.GpuTuningPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:IconGrid.Views"
             Background="Transparent">
    <ScrollViewer Margin="12"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsPageScrollBarStyle}" />
        </ScrollViewer.Resources>
        <views:GpuUndervoltSection Margin="0,0,8,0"
            OpenAfterburnerDownloadRequested="OpenAfterburnerDownload_Click"
            ProfileRowGameRequested="ProfileRowGame_Click"
            ProfileRowIdleRequested="ProfileRowIdle_Click"
            ProfileRowSaveRequested="ProfileRowSave_Click"
            ProfileRowDeleteRequested="ProfileRowDelete_Click"
            ApplyTuningRequested="GpuTuningApply_Click" />
    </ScrollViewer>
</UserControl>
