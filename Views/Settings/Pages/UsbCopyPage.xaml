<UserControl x:Class="IconGrid.Views.UsbCopyPage"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:IconGrid.Views"
             mc:Ignorable="d"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/TemplateGuidelines.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="UsbCopyActionButtonStyle" TargetType="Button" BasedOn="{StaticResource TemplateActionButtonStyle}">
                <Setter Property="Margin" Value="0,10,0,0" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Margin="12"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsPageScrollBarStyle}" />
        </ScrollViewer.Resources>

        <views:TemplatePage Margin="0,0,8,0">
            <views:TemplatePage.HeroContent>
                <StackPanel helpers:DevInspector.Metadata="USB Copy hero card -> Views/UsbCopyPage.xaml" xmlns:helpers="clr-namespace:IconGrid.Helpers">
                    <TextBlock Style="{StaticResource TemplateHeroTitleStyle}"
                               Text="{Binding UsbCopyTitle}" />
                    <TextBlock Style="{StaticResource TemplateHeroBodyStyle}"
                               Margin="0,8,0,0"
                               Text="{Binding UsbCopyIntro}" />
                </StackPanel>
            </views:TemplatePage.HeroContent>

            <views:TemplatePage.CardsContent>
                <StackPanel Grid.IsSharedSizeScope="True">

                    <!-- Devices -->
                    <Border Style="{StaticResource StartsideSectionCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TemplateCardTitleStyle}"
                                       Text="{Binding UsbCopyDevicesTitle}" />
                            <TextBlock Style="{StaticResource TemplateHeroBodyStyle}"
                                       Margin="0,4,0,0"
                                       Text="{Binding UsbCopyDevicesDescription}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox Grid.Column="0"
                                          Style="{StaticResource TemplateComboBoxStyle}"
                                          MinWidth="220"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding ViewModel.State.Devices, ElementName=Root}"
                                          SelectedItem="{Binding ViewModel.State.SelectedDevice, ElementName=Root, Mode=TwoWay}"
                                          DisplayMemberPath="Name" />

                                <Button Grid.Column="1"
                                        Style="{StaticResource UsbCopyActionButtonStyle}"
                                        Margin="12,0,0,0"
                                        Command="{Binding ViewModel.RefreshDevicesCommand, ElementName=Root}"
                                        Content="{Binding UsbCopyRefreshButton}" />
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <TextBlock Style="{StaticResource TemplateSmallTextStyle}"
                                           Text="{Binding UsbCopyPortTypeLabel}" />
                                <TextBlock Style="{StaticResource TemplateSmallTextStyle}"
                                           Margin="6,0,0,0"
                                           FontWeight="SemiBold"
                                           Text="{Binding ViewModel.State.SelectedDevice.PortTypeDisplay, ElementName=Root}" />
                                <TextBlock Style="{StaticResource TemplateSmallTextStyle}"
                                           Margin="16,0,0,0"
                                           Text="{Binding UsbCopyCapacityLabel}" />
                                <TextBlock Style="{StaticResource TemplateSmallTextStyle}"
                                           Margin="6,0,0,0"
                                           FontWeight="SemiBold"
                                           Text="{Binding ViewModel.State.SelectedDevice.CapacityDisplay, ElementName=Root}" />
                                <TextBlock Style="{StaticResource TemplateSmallTextStyle}"
                                           Margin="16,0,0,0"
                                           Text="{Binding UsbCopyFreeSpaceLabel}" />
                                <TextBlock Style="{StaticResource TemplateSmallTextStyle}"
                                           Margin="6,0,0,0"
                                           FontWeight="SemiBold"
                                           Text="{Binding ViewModel.State.SelectedDevice.FreeSpaceDisplay, ElementName=Root}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Copy -->
                    <Border Style="{StaticResource StartsideSectionCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TemplateCardTitleStyle}"
                                       Text="{Binding UsbCopyCopyTitle}" />
                            <TextBlock Style="{StaticResource TemplateHeroBodyStyle}"
                                       Margin="0,4,0,0"
                                       Text="{Binding UsbCopyCopyDescription}" />

                            <Button Style="{StaticResource UsbCopyActionButtonStyle}"
                                    Command="{Binding ViewModel.ChooseFilesCommand, ElementName=Root}"
                                    Content="{Binding UsbCopyChooseFilesButton}" />

                            <TextBlock Style="{StaticResource TemplateSectionTitleStyle}"
                                       Margin="0,14,0,0"
                                       Text="{Binding UsbCopyBufferSizeLabel}" />
                            <ComboBox Style="{StaticResource TemplateComboBoxStyle}"
                                      MinWidth="220"
                                      HorizontalAlignment="Left"
                                      Margin="0,4,0,0"
SelectedValuePath="Tag"
SelectedValue="{Binding ViewModel.State.BufferSize, ElementName=Root, Mode=TwoWay}">
                                <ComboBoxItem Content="64 KB" Tag="65536" />
                                <ComboBoxItem Content="128 KB" Tag="131072" />
                                <ComboBoxItem Content="256 KB" Tag="262144" />
                                <ComboBoxItem Content="512 KB" Tag="524288" />
                                <ComboBoxItem Content="1 MB" Tag="1048576" />
                                <ComboBoxItem Content="2 MB" Tag="2097152" />
                            </ComboBox>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Style="{StaticResource UsbCopyActionButtonStyle}"
                                        Margin="0,0,12,0"
                                        Command="{Binding ViewModel.StartCopyCommand, ElementName=Root}"
                                        Content="{Binding UsbCopyStartButton}" />
                                <Button Style="{StaticResource UsbCopyActionButtonStyle}"
                                        Command="{Binding ViewModel.CancelCopyCommand, ElementName=Root}"
                                        Content="{Binding UsbCopyCancelButton}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource TemplateSmallTextStyle}"
                                       Margin="0,10,0,0"
                                       Text="{Binding ViewModel.State.PipelineStatus, ElementName=Root}" />
                        </StackPanel>
                    </Border>

                    <!-- Performance -->
                    <Border Style="{StaticResource StartsideSectionCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TemplateCardTitleStyle}"
                                       Text="{Binding UsbCopyPerformanceTitle}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Style="{StaticResource TemplateSmallTextStyle}"
                                           Text="{Binding UsbCopyLiveSpeedLabel}" />
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Style="{StaticResource TemplateSmallTextStyle}"
                                           Margin="12,0,0,0"
                                           Text="{Binding ViewModel.State.LiveMiBS, ElementName=Root, StringFormat={}{0:0.00} MiB/s}" />

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Style="{StaticResource TemplateSmallTextStyle}"
                                           Margin="0,8,0,0"
                                           Text="{Binding UsbCopyAverageLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Style="{StaticResource TemplateSmallTextStyle}"
                                           Margin="12,8,0,0"
                                           Text="{Binding ViewModel.State.AverageMiBS, ElementName=Root, StringFormat={}{0:0.00} MiB/s}" />

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Style="{StaticResource TemplateSmallTextStyle}"
                                           Margin="0,8,0,0"
                                           Text="{Binding UsbCopyPeakLabel}" />
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Style="{StaticResource TemplateSmallTextStyle}"
                                           Margin="12,8,0,0"
                                           Text="{Binding ViewModel.State.PeakMiBS, ElementName=Root, StringFormat={}{0:0.00} MiB/s}" />

                                <TextBlock Grid.Row="0" Grid.Column="2"
                                           Style="{StaticResource TemplateSmallTextStyle}"
                                           Text="{Binding UsbCopyEtaLabel}" />
                                <TextBlock Grid.Row="1" Grid.Column="2"
                                           Style="{StaticResource TemplateSmallTextStyle}"
                                           Margin="40,8,0,0"
                                           Text="{Binding ViewModel.State.EtaText, ElementName=Root}" />
                            </Grid>

                            <ProgressBar Margin="0,14,0,0"
                                         Height="8"
                                         Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ViewModel.State.Progress, ElementName=Root}" />
                        </StackPanel>
                    </Border>

                    <!-- Log -->
                    <Border Style="{StaticResource StartsideSectionCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TemplateCardTitleStyle}"
                                       Text="{Binding UsbCopyLogTitle}" />

                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource UsbCopyActionButtonStyle}"
                                        Margin="0,0,12,0"
                                        Command="{Binding ViewModel.ViewLogCommand, ElementName=Root}"
                                        Content="{Binding UsbCopyViewLogButton}" />
                                <Button Style="{StaticResource UsbCopyActionButtonStyle}"
                                        Margin="0,0,12,0"
                                        Command="{Binding ViewModel.ExportLogCommand, ElementName=Root}"
                                        Content="{Binding UsbCopyExportLogButton}" />
                                <Button Style="{StaticResource UsbCopyActionButtonStyle}"
                                        Command="{Binding ViewModel.ClearLogCommand, ElementName=Root}"
                                        Content="{Binding UsbCopyClearLogButton}" />
                            </StackPanel>

                            <TextBlock Style="{StaticResource TemplateSmallTextStyle}"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="{Binding ViewModel.State.LogContent, ElementName=Root}" />
                        </StackPanel>
                    </Border>

                    <!-- Benchmark -->
                    <Border Style="{StaticResource StartsideSectionCardStyle}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TemplateCardTitleStyle}"
                                       Text="{Binding UsbCopyBenchmarkTitle}" />
                            <TextBlock Style="{StaticResource TemplateHeroBodyStyle}"
                                       Margin="0,4,0,0"
                                       Text="{Binding UsbCopyBenchmarkDescription}" />

                            <WrapPanel Margin="0,12,0,0">
                                <Button Style="{StaticResource UsbCopyActionButtonStyle}"
                                        Margin="0,0,12,8"
                                        Command="{Binding ViewModel.PortSpeedTestCommand, ElementName=Root}"
                                        Content="{Binding UsbCopyPortSpeedTestButton}" />
                                <Button Style="{StaticResource UsbCopyActionButtonStyle}"
                                        Margin="0,0,12,8"
                                        Command="{Binding ViewModel.ReadTestCommand, ElementName=Root}"
                                        Content="{Binding UsbCopyReadTestButton}" />
                                <Button Style="{StaticResource UsbCopyActionButtonStyle}"
                                        Margin="0,0,12,8"
                                        Command="{Binding ViewModel.WriteTestCommand, ElementName=Root}"
                                        Content="{Binding UsbCopyWriteTestButton}" />
                                <Button Style="{StaticResource UsbCopyActionButtonStyle}"
                                        Margin="0,0,12,8"
                                        Command="{Binding ViewModel.BufferStressTestCommand, ElementName=Root}"
                                        Content="{Binding UsbCopyBufferStressTestButton}" />
                                <Button Style="{StaticResource UsbCopyActionButtonStyle}"
                                        Command="{Binding ViewModel.StabilityTestCommand, ElementName=Root}"
                                        Content="{Binding UsbCopyStabilityTestButton}" />
                                <Button Style="{StaticResource UsbCopyActionButtonStyle}"
                                        Command="{Binding ViewModel.WindowsBaselineCommand, ElementName=Root}"
                                        Content="{Binding UsbCopyWindowsBaselineButton}" />
                            </WrapPanel>

                            <TextBlock Style="{StaticResource TemplateSmallTextStyle}"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="{Binding UsbCopyWindowsBaselineDescription}" />

                            <Button Style="{StaticResource UsbCopyActionButtonStyle}"
                                    Command="{Binding ViewModel.ExportCsvCommand, ElementName=Root}"
                                    Content="{Binding UsbCopyExportCsvButton}" />

                            <ItemsControl Margin="0,12,0,0"
                                          ItemsSource="{Binding ViewModel.State.BenchmarkResults, ElementName=Root}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource TemplateSmallTextStyle}"
                                                   Margin="0,4,0,0"
Text="{Binding TestName}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </views:TemplatePage.CardsContent>
        </views:TemplatePage>
    </ScrollViewer>
</UserControl>