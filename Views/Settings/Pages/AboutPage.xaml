<UserControl x:Class="IconGrid.Views.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:IconGrid.Helpers"
             xmlns:helpersCommon="clr-namespace:IconGrid.Helpers.Common"
             xmlns:views="clr-namespace:IconGrid.Views"
             mc:Ignorable="d"
             Background="Transparent">
    <ScrollViewer Margin="12"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsPageScrollBarStyle}" />
        </ScrollViewer.Resources>
        <views:TemplatePage Margin="0,0,8,0">
            <views:TemplatePage.HeroContent>
                <StackPanel helpers:DevInspector.Metadata="Om hero card → Views/AboutPage.xaml">
                    <TextBlock Style="{StaticResource TemplateHeroTitleStyle}"
                               Text="{Binding AboutTitleText}" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource TemplateHeroBodyStyle}"
                               Text="{Binding AboutIntroText}" />
                    <TextBlock Margin="0,16,0,0"
                               Style="{StaticResource TemplateHeroBodyStyle}"
                               Text="{x:Static helpersCommon:AppVersion.InformationalVersion}" />
                </StackPanel>
            </views:TemplatePage.HeroContent>
            <views:TemplatePage.CardsContent>
                <StackPanel>
                    <!-- Debug / Test was its own sidebar page until 2026-10-27; it now lives here. -->
                    <StackPanel helpers:DevInspector.Metadata="Test section → Views/TestSection.xaml">
                        <views:TestSection />
                    </StackPanel>
                </StackPanel>
            </views:TemplatePage.CardsContent>
        </views:TemplatePage>
    </ScrollViewer>
</UserControl>