<UserControl x:Class="IconGrid.Views.HjaelpPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:IconGrid.Helpers"
             xmlns:views="clr-namespace:IconGrid.Views"
             mc:Ignorable="d"
             Background="Transparent">
    <ScrollViewer Margin="12"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsPageScrollBarStyle}" />
        </ScrollViewer.Resources>
        <views:TemplatePage Margin="0,0,8,0">
        <views:TemplatePage.HeroContent>
            <StackPanel helpers:DevInspector.Metadata="Hjælp hero card → Views/HjaelpPage.xaml">
                <TextBlock Text="{Binding HelpTitleText}"
                           Style="{StaticResource TemplateHeroTitleStyle}" />
                <TextBlock Text="{Binding HelpIntroText}"
                           Margin="0,8,0,0"
                           Style="{StaticResource TemplateHeroBodyStyle}" />
            </StackPanel>
        </views:TemplatePage.HeroContent>
        <views:TemplatePage.CardsContent>
            <StackPanel>
                <Border Style="{StaticResource StartsideSectionCardStyle}"
                        helpers:DevInspector.Metadata="Shortcuts and tabs help card → Views/HjaelpPage.xaml">
                    <StackPanel>
                        <TextBlock Text="{Binding HelpShortcutsTitle}"
                                   Style="{StaticResource TemplateCardTitleStyle}" />
                        <TextBlock Text="{Binding HelpDragDropText}"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource TemplateHeroBodyStyle}"
                                   LineHeight="20" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StartsideSectionCardStyle}"
                        helpers:DevInspector.Metadata="Launcher help card → Views/HjaelpPage.xaml">
                    <StackPanel>
                        <TextBlock Text="{Binding HelpLauncherTitle}"
                                   Style="{StaticResource TemplateCardTitleStyle}" />
                        <TextBlock Text="{Binding HelpLauncherText}"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource TemplateHeroBodyStyle}"
                                   LineHeight="20" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StartsideSectionCardStyle}"
                        helpers:DevInspector.Metadata="Layout help card → Views/HjaelpPage.xaml">
                    <StackPanel>
                        <TextBlock Text="{Binding HelpLayoutsTitle}"
                                   Style="{StaticResource TemplateCardTitleStyle}" />
                        <TextBlock Text="{Binding HelpLayoutsText}"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource TemplateHeroBodyStyle}"
                                   LineHeight="20" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StartsideSectionCardStyle}"
                        helpers:DevInspector.Metadata="Monitor and overlay help card → Views/HjaelpPage.xaml">
                    <StackPanel>
                        <TextBlock Text="{Binding HelpMonitorTitle}"
                                   Style="{StaticResource TemplateCardTitleStyle}" />
                        <TextBlock Text="{Binding HelpTopBarText}"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource TemplateHeroBodyStyle}"
                                   LineHeight="20" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StartsideSectionCardStyle}"
                        helpers:DevInspector.Metadata="Hardware and GPU help card → Views/HjaelpPage.xaml">
                    <StackPanel>
                        <TextBlock Text="{Binding HelpHardwareTitle}"
                                   Style="{StaticResource TemplateCardTitleStyle}" />
                        <TextBlock Text="{Binding HelpSensorsText}"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource TemplateHeroBodyStyle}"
                                   LineHeight="20" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource StartsideSectionCardStyle}"
                        helpers:DevInspector.Metadata="Troubleshooting help card → Views/HjaelpPage.xaml">
                    <StackPanel>
                        <TextBlock Text="{Binding HelpTroubleshootingTitle}"
                                   Style="{StaticResource TemplateCardTitleStyle}" />
                        <TextBlock Text="{Binding HelpMoreTipsText}"
                                   Margin="0,8,0,0"
                                   Style="{StaticResource TemplateHeroBodyStyle}"
                                   LineHeight="20" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </views:TemplatePage.CardsContent>
        </views:TemplatePage>
    </ScrollViewer>
</UserControl>
