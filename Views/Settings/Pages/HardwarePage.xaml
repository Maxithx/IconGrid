<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="IconGrid.Views.HardwarePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:IconGrid.Helpers"
             xmlns:views="clr-namespace:IconGrid.Views"
             mc:Ignorable="d"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <helpers:BooleanToAngleConverter x:Key="HardwareExpanderAngleConverter" />
        <helpers:DiskStateLocalizationConverter x:Key="DiskStateTextConverter" />
        <helpers:DiskHealthToBrushConverter x:Key="DiskHealthBrushConverter" />

        <!--
            Text styles used inside the disk list. The shared template styles bind
            Foreground to the *DataContext*, which inside the item template is a
            PhysicalDiskStatus (no theme properties) and therefore falls back to black.
            These bind to the Window DataContext (MainViewModel) instead, so the disk
            section follows the Windows 11 light/dark theme like the rest of the page.
        -->
        <Style x:Key="HardwareDiskTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>
        <Style x:Key="HardwareDiskSmallTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground"
                    Value="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Style>
        <Style x:Key="HardwareDiskTemperatureStyle" TargetType="TextBlock" BasedOn="{StaticResource HardwareDiskSmallTextStyle}">
            <Style.Triggers>
                <!-- 40 °C and above: warning. -->
                <DataTrigger Binding="{Binding IsTemperatureWarm}" Value="True">
                    <Setter Property="Foreground" Value="#F59E0B" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <!-- 50 °C and above: critical. Must be last so it wins over the warning trigger. -->
                <DataTrigger Binding="{Binding IsTemperatureHot}" Value="True">
                    <Setter Property="Foreground" Value="#EF4444" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HardwareDiskChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="#26FFFFFF" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#14000000" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HardwareHeroExpanderToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HardwareHeroExpanderStyle" TargetType="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="HeaderSite"
                                          Style="{StaticResource HardwareHeroExpanderToggleButtonStyle}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="Stretch" />
                            <ContentPresenter x:Name="ExpandSite"
                                              Content="{TemplateBinding Content}"
                                              Margin="0"
                                              Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger SourceName="HeaderSite" Property="IsChecked" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger SourceName="HeaderSite" Property="IsChecked" Value="False">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <SolidColorBrush x:Key="HardwareScrollBarTrackDarkBrush" Color="#323232" />
        <SolidColorBrush x:Key="HardwareScrollBarTrackLightBrush" Color="#F0F2F5" />
        <SolidColorBrush x:Key="HardwareScrollBarThumbDarkBrush" Color="#9CA3AF" />
        <SolidColorBrush x:Key="HardwareScrollBarThumbLightBrush" Color="#CBD5E1" />

        <Style x:Key="HardwareScrollBarRepeatButtonStyle" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HardwareScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder"
                                Width="5"
                                Margin="3,4"
                                HorizontalAlignment="Center"
                                Background="{StaticResource HardwareScrollBarThumbDarkBrush}"
                                CornerRadius="3"
                                Opacity="0.78" />
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{StaticResource HardwareScrollBarThumbLightBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Width" Value="7" />
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.95" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Width" Value="7" />
                                <Setter TargetName="ThumbBorder" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HardwareScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid x:Name="Bg" SnapsToDevicePixels="true">
                            <Border x:Name="TrackBackground"
                                    Background="{StaticResource HardwareScrollBarTrackDarkBrush}"
                                    CornerRadius="6"
                                    Opacity="0.72" />
                            
                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="true"
                                   IsEnabled="{TemplateBinding IsEnabled}">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand"
                                                  Style="{StaticResource HardwareScrollBarRepeatButtonStyle}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource HardwareScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand"
                                                  Style="{StaticResource HardwareScrollBarRepeatButtonStyle}" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="TrackBackground" Property="Background" Value="{StaticResource HardwareScrollBarTrackLightBrush}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TrackBackground" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HardwareMetricTileStyle" TargetType="Border">
            <Setter Property="Background" Value="#12000000" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Background" Value="#FFF4F6F8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <Style x:Key="MemoryMetricTileStyle"
               TargetType="Border"
               BasedOn="{StaticResource HardwareMetricTileStyle}">
            <Setter Property="Padding" Value="8,12,12,12" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="HardwareSearchButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter ContentSource="Content"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.7" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Grid.IsSharedSizeScope="True">
        <ScrollViewer Margin="12"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar" BasedOn="{StaticResource HardwareScrollBarStyle}" />
            </ScrollViewer.Resources>
            
            <views:TemplatePage Margin="0,0,8,0">
                <!-- Motherboard hero card -->
                <views:TemplatePage.HeroContent>
                    <StackPanel helpers:DevInspector.Metadata="Motherboard hero card -> Views/HardwarePage.xaml">
                        <Expander Style="{StaticResource HardwareHeroExpanderStyle}"
                                  IsExpanded="False"
                                  helpers:DevInspector.Metadata="Motherboard hero expander -> Views/HardwarePage.xaml">
                            <Expander.Header>
                                <StackPanel>
                                    <!-- 3-column header: Title | Logo | Chevron -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" SharedSizeGroup="HardwareLogoColumn" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding HardwareBoardTitleText}"
                                                   VerticalAlignment="Center"
                                                   Style="{StaticResource TemplateCardTitleStyle}" />
                                        <Image Grid.Column="1"
                                               Width="80" Height="34"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Stretch="Uniform"
                                               SnapsToDevicePixels="True">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="Source" Value="pack://siteoforigin:,,,/Assets/Hw-logo/Asuslogo-dark-theme.png" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAsusMotherboard, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Source" Value="pack://siteoforigin:,,,/Assets/Hw-logo/Asuslogo-light-theme.png" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <TextBlock Grid.Column="2"
                                                   Text="&#xE70D;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="18"
                                                   Margin="24,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource HardwareExpanderAngleConverter}}" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Grid>
                                    <TextBlock Margin="0,8,0,0"
                                               Style="{StaticResource TemplateSectionTitleStyle}"
                                               Text="{Binding Overview.Board.Model, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Expander.Header>
                            <Expander.Content>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,16"
                                               Text="{Binding HardwareBoardIntroText}"
                                               Style="{StaticResource TemplateHeroBodyStyle}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,18,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="{Binding HardwareModelLabelText}"
                                                           Style="{StaticResource TemplateSmallTextStyle}" />
                                                <Button Grid.Column="1"
                                                        Style="{StaticResource HardwareSearchButtonStyle}"
                                                        Content="{Binding HardwareSearchBoardLabelText}"
                                                        Click="SearchBoardButton_Click" />
                                                <TextBlock Grid.Row="1"
                                                           Margin="0,4,0,0"
                                                           Style="{StaticResource TemplateCardTitleStyle}"
                                                           Text="{Binding Overview.Board.Model, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                           TextWrapping="Wrap" />
                                            </Grid>
                                        </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding HardwareBiosLabelText}"
                                                   Style="{StaticResource TemplateSmallTextStyle}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   Style="{StaticResource TemplateCardTitleStyle}"
                                                   Text="{Binding Overview.Board.BiosVersion, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                </StackPanel>
                            </Expander.Content>
                        </Expander>
                    </StackPanel>
                </views:TemplatePage.HeroContent>
                
                <views:TemplatePage.CardsContent>
                    <StackPanel>
                        <!-- CPU card -->
                        <Border Style="{StaticResource StartsideSectionCardStyle}"
                                helpers:DevInspector.Metadata="CPU card -> Views/HardwarePage.xaml">
                            <Expander Style="{StaticResource HardwareHeroExpanderStyle}"
                                      IsExpanded="False"
                                      helpers:DevInspector.Metadata="CPU card expander -> Views/HardwarePage.xaml">
                                <Expander.Header>
                                    <StackPanel>
                                        <!-- 3-column header: Title | Logo | Chevron -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="HardwareLogoColumn" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="CPU"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource TemplateCardTitleStyle}" />
                                            <Grid Grid.Column="1"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center">
                                                <Border MinWidth="76"
                                                        Padding="12,6"
                                                        Background="{Binding CpuBadgeBackground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                        CornerRadius="12">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAmdCpu, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsIntelCpu, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Overview.Cpu.Vendor, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontSize="12"
                                                               FontWeight="SemiBold"
                                                               Foreground="White" />
                                                </Border>
                                                <Image Width="100" Height="34"
                                                       HorizontalAlignment="Center"
                                                       Stretch="Uniform"
                                                       SnapsToDevicePixels="True">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Setter Property="Source" Value="pack://siteoforigin:,,,/Assets/Hw-logo/AMDlogo-darktheme.png" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAmdCpu, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                    <Setter Property="Source" Value="pack://siteoforigin:,,,/Assets/Hw-logo/AMDlogo-lighttheme.png" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <Image Width="100" Height="34"
                                                       HorizontalAlignment="Center"
                                                       Stretch="Uniform"
                                                       SnapsToDevicePixels="True">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Setter Property="Source" Value="pack://siteoforigin:,,,/Assets/Hw-logo/Intel-logo.png" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsIntelCpu, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Grid>
                                            <TextBlock Grid.Column="2"
                                                       Text="&#xE70D;"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="18"
                                                       Margin="24,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform Angle="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource HardwareExpanderAngleConverter}}" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Margin="0,8,0,0"
                                                   Style="{StaticResource TemplateSectionTitleStyle}"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}  @  {1}">
                                                    <Binding Path="Overview.Cpu.Name" RelativeSource="{RelativeSource AncestorType={x:Type views:HardwarePage}}" />
                                                    <Binding Path="DataContext.SystemMonitor.CpuClock" RelativeSource="{RelativeSource AncestorType={x:Type views:HardwarePage}}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Expander.Header>
                                <Expander.Content>
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,16"
                                                   Text="{Binding HardwareCpuIntroText}"
                                                   Style="{StaticResource TemplateHeroBodyStyle}" />
                                        <Grid Margin="0,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding HardwareModelLabelText}"
                                                       Style="{StaticResource TemplateSmallTextStyle}" />
                                            <TextBlock Grid.Row="1"
                                                       Margin="0,4,0,0"
                                                       Style="{StaticResource TemplateCardTitleStyle}"
                                                       Text="{Binding Overview.Cpu.Name, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                       TextWrapping="Wrap" />
                                        </Grid>
                                        <WrapPanel Margin="0,18,0,0">
                                            <Border Style="{StaticResource HardwareMetricTileStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HardwareCoresLabelText}" Style="{StaticResource TemplateSmallTextStyle}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TemplateCardTitleStyle}"
                                                               Text="{Binding Overview.Cpu.Cores, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource HardwareMetricTileStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HardwareThreadsLabelText}" Style="{StaticResource TemplateSmallTextStyle}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TemplateCardTitleStyle}"
                                                               Text="{Binding Overview.Cpu.Threads, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource HardwareMetricTileStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HardwareLiveTempLabelText}" Style="{StaticResource TemplateSmallTextStyle}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TemplateCardTitleStyle}"
                                                               Text="{Binding DataContext.SystemMonitor.CpuTemp, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource HardwareMetricTileStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HardwareLiveUsageLabelText}" Style="{StaticResource TemplateSmallTextStyle}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TemplateCardTitleStyle}"
                                                               Text="{Binding DataContext.SystemMonitor.CpuUsage, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource HardwareMetricTileStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HardwareLiveClockLabelText}" Style="{StaticResource TemplateSmallTextStyle}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TemplateCardTitleStyle}"
                                                               Text="{Binding DataContext.SystemMonitor.CpuClock, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource HardwareMetricTileStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HardwareBoostLabelText}" Style="{StaticResource TemplateSmallTextStyle}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TemplateCardTitleStyle}"
                                                               Text="{Binding Overview.Cpu.BoostClock, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource HardwareMetricTileStyle}" Margin="0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HardwareVoltageLabelText}" Style="{StaticResource TemplateSmallTextStyle}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TemplateCardTitleStyle}"
                                                               Text="{Binding DataContext.SystemMonitor.CpuVoltage, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Expander.Content>
                            </Expander>
                        </Border>

                        <!-- GPU card -->
                        <Border Style="{StaticResource StartsideSectionCardStyle}"
                                helpers:DevInspector.Metadata="GPU card -> Views/HardwarePage.xaml">
                            <Expander Style="{StaticResource HardwareHeroExpanderStyle}"
                                      IsExpanded="False"
                                      helpers:DevInspector.Metadata="GPU card expander -> Views/HardwarePage.xaml">
                                <Expander.Header>
                                    <StackPanel>
                                        <!-- 3-column header: Title | Logo | Chevron -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="HardwareLogoColumn" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="GPU"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource TemplateCardTitleStyle}" />
                                            <Grid Grid.Column="1"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center">
                                                <Border MinWidth="76"
                                                        Padding="12,6"
                                                        Background="{Binding GpuBadgeBackground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                        CornerRadius="12">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNvidiaGpu, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsIntelGpu, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Overview.Gpu.Vendor, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                                </Border>
                                                <Image Width="100" Height="34" HorizontalAlignment="Center" Stretch="Uniform" SnapsToDevicePixels="True">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Setter Property="Source" Value="pack://siteoforigin:,,,/Assets/Hw-logo/Nvidia-RTX-logo.png" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNvidiaRtx, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <Image Width="100" Height="34" HorizontalAlignment="Center" Stretch="Uniform" SnapsToDevicePixels="True">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Setter Property="Source" Value="pack://siteoforigin:,,,/Assets/Hw-logo/Nvidia-GTX-logo.png" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsNvidiaGtx, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                                <Image Width="100" Height="34" HorizontalAlignment="Center" Stretch="Uniform" SnapsToDevicePixels="True">
                                                    <Image.Style>
                                                        <Style TargetType="Image">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Setter Property="Source" Value="pack://siteoforigin:,,,/Assets/Hw-logo/Intel-logo.png" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsIntelGpu, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Image.Style>
                                                </Image>
                                            </Grid>
                                            <TextBlock Grid.Column="2"
                                                       Text="&#xE70D;"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="18"
                                                       Margin="24,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform Angle="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource HardwareExpanderAngleConverter}}" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Margin="0,8,0,0"
                                                   Style="{StaticResource TemplateSectionTitleStyle}"
                                                   Text="{Binding Overview.Gpu.Name, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Expander.Header>
                                <Expander.Content>
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,16"
                                                   Text="{Binding HardwareGpuIntroText}"
                                                   Style="{StaticResource TemplateHeroBodyStyle}" />
                                        <Grid Margin="0,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding HardwareModelLabelText}" Style="{StaticResource TemplateSmallTextStyle}" />
                                            <TextBlock Grid.Row="1" Margin="0,4,0,0" Style="{StaticResource TemplateCardTitleStyle}"
                                                       Text="{Binding Overview.Gpu.Name, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" TextWrapping="Wrap" />
                                        </Grid>
                                        <WrapPanel Margin="-6,18,0,0">
                                            <Border Style="{StaticResource HardwareMetricTileStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HardwareVendorLabelText}" Style="{StaticResource TemplateSmallTextStyle}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TemplateCardTitleStyle}"
                                                               Text="{Binding GpuVendorDisplay, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource HardwareMetricTileStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HardwareLiveTempLabelText}" Style="{StaticResource TemplateSmallTextStyle}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TemplateCardTitleStyle}"
                                                               Text="{Binding DataContext.SystemMonitor.GpuTemp, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource HardwareMetricTileStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HardwareLiveClockLabelText}" Style="{StaticResource TemplateSmallTextStyle}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TemplateCardTitleStyle}"
                                                               Text="{Binding DataContext.SystemMonitor.GpuClock, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource HardwareMetricTileStyle}" Margin="0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HardwareVramLabelText}" Style="{StaticResource TemplateSmallTextStyle}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TemplateCardTitleStyle}"
                                                               Text="{Binding Overview.Gpu.Vram, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Expander.Content>
                            </Expander>
                        </Border>

                        <!-- Memory card -->
                        <Border Style="{StaticResource StartsideSectionCardStyle}"
                                helpers:DevInspector.Metadata="Memory card -> Views/HardwarePage.xaml">
                            <Expander Style="{StaticResource HardwareHeroExpanderStyle}"
                                      IsExpanded="False"
                                      helpers:DevInspector.Metadata="Memory card expander -> Views/HardwarePage.xaml">
                                <Expander.Header>
                                    <StackPanel>
                                        <!-- 3-column header: Title | Logo | Chevron -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="HardwareLogoColumn" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding HardwareMemoryTitleText}"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource TemplateCardTitleStyle}" />
                                            <Border Grid.Column="1"
                                                    MinWidth="76"
                                                    Padding="12,6"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding AccentBrush}"
                                                    CornerRadius="12">
                                                <TextBlock Text="{Binding Overview.Memory.Total, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       Text="&#xE70D;"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="18"
                                                       Margin="24,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform Angle="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource HardwareExpanderAngleConverter}}" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Grid>
                                        <TextBlock Margin="0,8,0,0"
                                                   Style="{StaticResource TemplateSectionTitleStyle}"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Text>
                                                <MultiBinding StringFormat="{}{0}  {1} @ {2}">
                                                    <Binding Path="Overview.Memory.Layout" RelativeSource="{RelativeSource AncestorType={x:Type views:HardwarePage}}" />
                                                    <Binding Path="Overview.Memory.Type" RelativeSource="{RelativeSource AncestorType={x:Type views:HardwarePage}}" />
                                                    <Binding Path="Overview.Memory.Speed" RelativeSource="{RelativeSource AncestorType={x:Type views:HardwarePage}}" />
                                                </MultiBinding>
                                            </TextBlock.Text>
                                        </TextBlock>
                                    </StackPanel>
                                </Expander.Header>
                                <Expander.Content>
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,16"
                                                   Text="{Binding HardwareMemoryIntroText}"
                                                   Style="{StaticResource TemplateHeroBodyStyle}" />
                                        <Grid Margin="0,0,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding HardwareLayoutLabelText}" Style="{StaticResource TemplateSmallTextStyle}" />
                                            <TextBlock Grid.Row="1" Margin="0,4,0,0" Style="{StaticResource TemplateCardTitleStyle}"
                                                       Text="{Binding Overview.Memory.Layout, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" TextWrapping="Wrap" />
                                        </Grid>
                                        <WrapPanel Margin="0,18,0,0">
                                            <Border Style="{StaticResource MemoryMetricTileStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HardwareTypeLabelText}" Style="{StaticResource TemplateSmallTextStyle}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TemplateCardTitleStyle}"
                                                               Text="{Binding Overview.Memory.Type, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MemoryMetricTileStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HardwareSpeedLabelText}" Style="{StaticResource TemplateSmallTextStyle}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TemplateCardTitleStyle}"
                                                               Text="{Binding Overview.Memory.Speed, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MemoryMetricTileStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HardwareTimingLabelText}" Style="{StaticResource TemplateSmallTextStyle}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TemplateCardTitleStyle}"
                                                               Text="{Binding Overview.Memory.Timing, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MemoryMetricTileStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HardwareModulesLabelText}" Style="{StaticResource TemplateSmallTextStyle}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TemplateCardTitleStyle}"
                                                               Text="{Binding Overview.Memory.ModuleCount, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MemoryMetricTileStyle}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HardwareSlotsLabelText}" Style="{StaticResource TemplateSmallTextStyle}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TemplateCardTitleStyle}"
                                                               Text="{Binding Overview.Memory.SlotsUsed, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource MemoryMetricTileStyle}" Margin="0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding HardwareVoltageLabelText}" Style="{StaticResource TemplateSmallTextStyle}" />
                                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource TemplateCardTitleStyle}"
                                                               Text="{Binding Overview.Memory.Voltage, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                </StackPanel>
                                            </Border>
                                        </WrapPanel>
                                    </StackPanel>
                                </Expander.Content>
                            </Expander>
                        </Border>
                        <!-- Disks card -->
                        <Border Style="{StaticResource StartsideSectionCardStyle}"
                                helpers:DevInspector.Metadata="Disks card -> Views/HardwarePage.xaml">
                            <Expander Style="{StaticResource HardwareHeroExpanderStyle}"
                                      IsExpanded="False"
                                      helpers:DevInspector.Metadata="Disks card expander -> Views/HardwarePage.xaml">
                                <Expander.Header>
                                    <StackPanel>
                                        <!-- 3-column header: Title | Count | Chevron -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" SharedSizeGroup="HardwareLogoColumn" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding HardwareDisksTitleText}"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource HardwareDiskTitleStyle}" />
                                            <Border Grid.Column="1"
                                                    MinWidth="76"
                                                    Padding="12,6"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    Background="{Binding AccentBrush}"
                                                    CornerRadius="12">
                                                <TextBlock Text="{Binding DataContext.SystemMonitor.Disks.Count, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                                           FontSize="12" FontWeight="SemiBold" Foreground="White" />
                                            </Border>
                                            <TextBlock Grid.Column="2"
                                                       Text="&#xE70D;"
                                                       FontFamily="Segoe Fluent Icons"
                                                       FontSize="18"
                                                       Margin="24,0,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                       RenderTransformOrigin="0.5,0.5">
                                                <TextBlock.RenderTransform>
                                                    <RotateTransform Angle="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource HardwareExpanderAngleConverter}}" />
                                                </TextBlock.RenderTransform>
                                            </TextBlock>
                                        </Grid>
                                    </StackPanel>
                                </Expander.Header>
                                <Expander.Content>
                                    <StackPanel>
                                        <TextBlock Margin="0,0,0,16"
                                                   Text="{Binding HardwareDisksIntroText}"
                                                   TextWrapping="Wrap"
                                                   Style="{StaticResource TemplateHeroBodyStyle}" />
                                        <ItemsControl ItemsSource="{Binding DataContext.SystemMonitor.Disks, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource HardwareMetricTileStyle}" Margin="0,0,0,8">
                                                        <StackPanel>
                                                            <!-- Model + drive letter + health chip -->
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding ModelText}"
                                                                           Style="{StaticResource HardwareDiskTitleStyle}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />
                                                                <Border Grid.Column="1"
                                                                        Margin="8,0,0,0"
                                                                        Style="{StaticResource HardwareDiskChipStyle}"
                                                                        VerticalAlignment="Center"
                                                                        Visibility="{Binding HasDriveLetters, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock Text="{Binding DriveLetters}"
                                                                               FontSize="12"
                                                                               FontWeight="SemiBold"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                </Border>
                                                                <Border Grid.Column="3" Margin="8,0,0,0" Style="{StaticResource HardwareDiskChipStyle}">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                                                                 Fill="{Binding Health, Converter={StaticResource DiskHealthBrushConverter}}" />
                                                                        <TextBlock Margin="6,0,0,0" FontSize="12" VerticalAlignment="Center"
                                                                                   Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}">
                                                                            <TextBlock.Text>
                                                                                <MultiBinding Converter="{StaticResource DiskStateTextConverter}" ConverterParameter="HardwareDiskHealth">
                                                                                    <Binding Path="Health" />
                                                                                    <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                                </MultiBinding>
                                                                            </TextBlock.Text>
                                                                        </TextBlock>
                                                                        <TextBlock Margin="6,0,0,0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                                                   Text="{Binding HealthPercentText}"
                                                                                   Visibility="{Binding HasHealthPercent, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                   Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </Grid>
                                                            <!-- Type / bus / size / temperature / SMART summary -->
                                                            <WrapPanel Margin="0,8,0,0">
                                                                <TextBlock Style="{StaticResource HardwareDiskSmallTextStyle}">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding Converter="{StaticResource DiskStateTextConverter}" ConverterParameter="HardwareDiskType">
                                                                            <Binding Path="MediaType" />
                                                                            <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                                <TextBlock Text=" · " Style="{StaticResource HardwareDiskSmallTextStyle}" />
                                                                <TextBlock Text="{Binding BusType}" Style="{StaticResource HardwareDiskSmallTextStyle}" />
                                                                <TextBlock Text=" · " Style="{StaticResource HardwareDiskSmallTextStyle}" />
                                                                <TextBlock Text="{Binding SizeText}" Style="{StaticResource HardwareDiskSmallTextStyle}" />
                                                                <TextBlock Text=" · " Style="{StaticResource HardwareDiskSmallTextStyle}" />
                                                                <TextBlock Text="{Binding TemperatureText}" Style="{StaticResource HardwareDiskTemperatureStyle}" />
                                                                <TextBlock Text=" · " Style="{StaticResource HardwareDiskSmallTextStyle}" />
                                                                <TextBlock Style="{StaticResource HardwareDiskSmallTextStyle}">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding Converter="{StaticResource DiskStateTextConverter}" ConverterParameter="HardwareDiskSmart">
                                                                            <Binding Path="SmartStatus" />
                                                                            <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                            </WrapPanel>
                                                            <!-- SATA HDD spin state (only rotating SATA media) -->
                                                            <StackPanel Margin="0,10,0,0"
                                                                        Visibility="{Binding ShowPowerState, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding HardwareDiskPowerLabelText}"
                                                                               Style="{StaticResource HardwareDiskSmallTextStyle}"
                                                                               VerticalAlignment="Center" />
                                                                    <Border Margin="8,0,0,0" Style="{StaticResource HardwareDiskChipStyle}">
                                                                        <TextBlock FontSize="12" FontWeight="SemiBold"
                                                                                   Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}">
                                                                            <TextBlock.Text>
                                                                                <MultiBinding Converter="{StaticResource DiskStateTextConverter}" ConverterParameter="HardwareDiskPower">
                                                                                    <Binding Path="PowerState" />
                                                                                    <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                                </MultiBinding>
                                                                            </TextBlock.Text>
                                                                        </TextBlock>
                                                                    </Border>
                                                                    <TextBlock Margin="12,0,0,0" Text="{Binding HardwareDiskActivityLabelText}"
                                                                               Style="{StaticResource HardwareDiskSmallTextStyle}" VerticalAlignment="Center" />
                                                                    <TextBlock Margin="4,0,0,0" Text="{Binding ActivityText}"
                                                                               Style="{StaticResource HardwareDiskSmallTextStyle}" VerticalAlignment="Center" />
                                                                    <TextBlock Margin="12,0,0,0" Text="{Binding HardwareDiskIoLabelText}"
                                                                               Style="{StaticResource HardwareDiskSmallTextStyle}" VerticalAlignment="Center" />
                                                                    <TextBlock Margin="4,0,0,0" Text="{Binding ReadRateText}"
                                                                               Style="{StaticResource HardwareDiskSmallTextStyle}" VerticalAlignment="Center" />
                                                                    <TextBlock Margin="4,0,0,0" Text="{Binding WriteRateText}"
                                                                               Style="{StaticResource HardwareDiskSmallTextStyle}" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                                                                           Style="{StaticResource HardwareDiskSmallTextStyle}">
                                                                    <TextBlock.Text>
                                                                        <MultiBinding Converter="{StaticResource DiskStateTextConverter}" ConverterParameter="HardwareDiskPowerHint">
                                                                            <Binding Path="PowerState" />
                                                                            <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                        </MultiBinding>
                                                                    </TextBlock.Text>
                                                                </TextBlock>
                                                            </StackPanel>
                                                            <!-- SMART attribute details -->
                                                            <Expander Margin="0,12,0,0" IsExpanded="False">
                                                                <Expander.Header>
                                                                    <TextBlock Text="{Binding HardwareDiskSmartTitleText}"
                                                                               Style="{StaticResource HardwareDiskSmallTextStyle}" />
                                                                </Expander.Header>
                                                                <StackPanel Margin="0,8,0,0">
                                                                    <TextBlock Text="{Binding HardwareDiskSmartUnavailableText}"
                                                                               TextWrapping="Wrap"
                                                                               Style="{StaticResource HardwareDiskSmallTextStyle}"
                                                                               Visibility="{Binding HasNoSmart, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    <StackPanel Visibility="{Binding HasSmart, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <Grid Margin="0,0,0,4">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="44" />
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="80" />
                                                                                <ColumnDefinition Width="70" />
                                                                                <ColumnDefinition Width="100" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <TextBlock Grid.Column="0" Text="ID" Style="{StaticResource HardwareDiskSmallTextStyle}" />
                                                                            <TextBlock Grid.Column="1" Text="{Binding HardwareDiskSmartAttributeColumnText}" Style="{StaticResource HardwareDiskSmallTextStyle}" />
                                                                            <TextBlock Grid.Column="2" Text="{Binding HardwareDiskSmartValueColumnText}" Style="{StaticResource HardwareDiskSmallTextStyle}" TextAlignment="Right" />
                                                                            <TextBlock Grid.Column="3" Text="{Binding HardwareDiskSmartThresholdColumnText}" Style="{StaticResource HardwareDiskSmallTextStyle}" TextAlignment="Right" />
                                                                            <TextBlock Grid.Column="4" Text="{Binding HardwareDiskSmartStatusColumnText}" Style="{StaticResource HardwareDiskSmallTextStyle}" TextAlignment="Right" />
                                                                        </Grid>
                                                                        <ItemsControl ItemsSource="{Binding SmartAttributes}">
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate>
                                                                                    <Grid Margin="0,3,0,0">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="44" />
                                                                                            <ColumnDefinition Width="*" />
                                                                                            <ColumnDefinition Width="80" />
                                                                                            <ColumnDefinition Width="70" />
                                                                                            <ColumnDefinition Width="100" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <TextBlock Grid.Column="0" Text="{Binding IdText}" Style="{StaticResource HardwareDiskSmallTextStyle}" />
                                                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource HardwareDiskSmallTextStyle}" TextTrimming="CharacterEllipsis" />
                                                                                        <TextBlock Grid.Column="2" Text="{Binding ValueText}" Style="{StaticResource HardwareDiskSmallTextStyle}" TextAlignment="Right" />
                                                                                        <TextBlock Grid.Column="3" Text="{Binding ThresholdText}" Style="{StaticResource HardwareDiskSmallTextStyle}" TextAlignment="Right" />
                                                                                        <TextBlock Grid.Column="4" Style="{StaticResource HardwareDiskSmallTextStyle}" TextAlignment="Right">
                                                                                            <TextBlock.Text>
                                                                                                <MultiBinding Converter="{StaticResource DiskStateTextConverter}" ConverterParameter="HardwareDiskSmartAttributeStatus">
                                                                                                    <Binding Path="Status" />
                                                                                                    <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                                                </MultiBinding>
                                                                                            </TextBlock.Text>
                                                                                        </TextBlock>
                                                                                    </Grid>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Expander>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{Binding HardwareDiskNoDisksText}"
                                                   TextWrapping="Wrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource TemplateSmallTextStyle}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.SystemMonitor.Disks.Count, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Expander.Content>
                            </Expander>
                        </Border>
                    </StackPanel>
                </views:TemplatePage.CardsContent>
            </views:TemplatePage>
        </ScrollViewer>
    </Grid>
</UserControl>