<UserControl x:Class="IconGrid.Views.MonitorPingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:IconGrid.Helpers"
             xmlns:views="clr-namespace:IconGrid.Views"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/TemplateGuidelines.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <helpers:StringEqualsToVisibilityConverter x:Key="StringEqualsToVisibilityConverter" />
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer Margin="12"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False"
                  PanningMode="VerticalOnly">
        <ScrollViewer.Resources>
            <Style TargetType="ScrollBar" BasedOn="{StaticResource SettingsPageScrollBarStyle}" />
        </ScrollViewer.Resources>
        <views:TemplatePage Margin="0,0,8,0">
            <views:TemplatePage.HeroContent>
                <StackPanel helpers:DevInspector.Metadata="Monitor ping page hero card -> Views/MonitorPingPage.xaml">
                    <TextBlock Style="{StaticResource TemplateHeroTitleStyle}"
                               Text="{Binding MonitorPingPageTitle}" />
                    <TextBlock Style="{StaticResource TemplateHeroBodyStyle}"
                               Margin="0,8,0,0"
                               Text="{Binding MonitorPingPageIntro}" />
                </StackPanel>
            </views:TemplatePage.HeroContent>
            <views:TemplatePage.CardsContent>
                <StackPanel>

                    <!-- Ping target selection -->
                    <Border Style="{StaticResource StartsideSectionCardStyle}"
                            helpers:DevInspector.Metadata="Monitor ping target card">
                        <StackPanel>
                            <TextBlock Style="{StaticResource TemplateCardTitleStyle}"
                                       Text="{Binding MonitorPingTargetTitle}" />
                            <TextBlock Style="{StaticResource TemplateHeroBodyStyle}"
                                       Margin="0,4,20,0"
                                       Text="{Binding MonitorPingTargetDescription}" />

                            <ComboBox Margin="0,14,0,0"
                                      MaxWidth="360"
                                      HorizontalAlignment="Left"
                                      ItemsSource="{Binding MonitorPingTargetItems}"
                                      SelectedValuePath="Key"
                                      DisplayMemberPath="Value"
                                      SelectedValue="{Binding MonitorPingTargetMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <!-- Custom target input — visible only when MonitorPingTargetMode == "Custom" -->
                            <StackPanel Margin="0,14,0,0"
                                        Visibility="{Binding MonitorPingTargetMode, Converter={StaticResource StringEqualsToVisibilityConverter}, ConverterParameter=Custom}">
                                <TextBlock Style="{StaticResource TemplateSectionTitleStyle}"
                                           Text="{Binding MonitorPingCustomTargetTitle}" />
                                <TextBlock Style="{StaticResource TemplateHeroBodyStyle}"
                                           Margin="0,4,20,0"
                                           Text="{Binding MonitorPingCustomTargetDescription}" />
                                <TextBox Margin="0,8,0,0"
                                         MaxWidth="280"
                                         HorizontalAlignment="Left"
                                         Text="{Binding MonitorPingCustomTarget, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </views:TemplatePage.CardsContent>
        </views:TemplatePage>
    </ScrollViewer>
</UserControl>