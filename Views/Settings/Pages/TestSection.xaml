<UserControl x:Class="IconGrid.Views.TestSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:IconGrid.Helpers"
             xmlns:views="clr-namespace:IconGrid.Views"
             mc:Ignorable="d"
             Background="Transparent"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/TemplateGuidelines.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <!--
        Embedded at the bottom of the About page. The diagnostics/debug surface is no
        longer its own sidebar page, so it renders as a plain stack of settings cards.
    -->
    <StackPanel>
        <Border Style="{StaticResource StartsideSectionCardStyle}"
                helpers:DevInspector.Metadata="Test section intro card -> Views/TestSection.xaml">
            <StackPanel>
                <TextBlock Style="{StaticResource TemplateCardTitleStyle}"
                           Text="Diagnostics" />
                <Border Margin="0,10,0,0"
                        Padding="10,8"
                        CornerRadius="8"
                        Background="{Binding DataContext.SettingsCardBackground, RelativeSource={RelativeSource AncestorType=Window}}">
                    <TextBlock Style="{StaticResource TemplateSmallTextStyle}"
                               FontFamily="Consolas"
                               TextWrapping="Wrap"
                               Text="{Binding SummaryText, RelativeSource={RelativeSource AncestorType={x:Type views:TestSection}}}" />
                </Border>
                <TextBlock Margin="0,8,0,0"
                           Style="{StaticResource TemplateHeroBodyStyle}"
                           Text="Startup state, elevation and running instances of IconGrid. FPS and ETW setup is on the Gaming Overlay page." />
            </StackPanel>
        </Border>
                <Border Style="{StaticResource StartsideSectionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TemplateCardTitleStyle}"
                                   Text="IconGrid process overview" />
                        <TextBlock Margin="0,10,0,0"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Text="{Binding ProcessInfo, RelativeSource={RelativeSource AncestorType={x:Type views:TestSection}}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StartsideSectionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TemplateCardTitleStyle}"
                                   Text="Startup diagnostics" />
                        <TextBlock Margin="0,10,0,0"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Text="{Binding StartupDiagnosticsInfo, RelativeSource={RelativeSource AncestorType={x:Type views:TestSection}}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource StartsideSectionCardStyle}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TemplateCardTitleStyle}"
                                   Text="Trace log" />
                        <TextBlock Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Text="Diagnostic log written by the launcher and the monitor agent. It is trimmed automatically so it never grows too large. Use Clean to empty it on demand." />
                        <TextBlock Margin="0,10,0,0"
                                   FontFamily="Consolas"
                                   TextWrapping="Wrap"
                                   Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Text="{Binding TraceLogInfo, RelativeSource={RelativeSource AncestorType={x:Type views:TestSection}}}" />
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding DataContext.TraceLoggingToggleTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <TextBlock Margin="0,4,20,0"
                                           TextWrapping="Wrap"
                                           Text="{Binding DataContext.TraceLoggingToggleDescription, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <TextBlock Margin="0,4,0,0"
                                           Text="{Binding DataContext.TraceLoggingStateText, RelativeSource={RelativeSource AncestorType=Window}}"
                                           Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                            <ToggleButton Grid.Column="1"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource ToggleSwitchStyle}"
                                          IsChecked="{Binding DataContext.TraceLoggingEnabled, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
                        </Grid>
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,12,0,0">
                            <Button Content="Refresh"
                                    Click="RefreshTraceLogButton_Click"
                                    Padding="14,8"
                                    MinWidth="110"
                                    Background="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                    BorderBrush="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Foreground="White"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Cursor="Hand" />
                            <Button Content="Clean trace log"
                                    Click="CleanTraceLogButton_Click"
                                    Margin="10,0,0,0"
                                    Padding="14,8"
                                    MinWidth="150"
                                    Background="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                    BorderBrush="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Foreground="White"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Cursor="Hand" />
                            <TextBlock Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Text="{Binding TraceLogStatusText, RelativeSource={RelativeSource AncestorType={x:Type views:TestSection}}}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

    </StackPanel>
</UserControl>
