<UserControl x:Class="IconGrid.Views.GameResolutionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:helpers="clr-namespace:IconGrid.Helpers"
             xmlns:views="clr-namespace:IconGrid.Views"
             mc:Ignorable="d"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />

        <Style x:Key="GameResComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Background" Value="White" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <Style x:Key="GameResComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource GameResComboBoxItemStyle}" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="#D1D5DB" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                    <Setter Property="Background" Value="White" />
                    <Setter Property="BorderBrush" Value="#4D4D4D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding CurrentResolutionLabelText, RelativeSource={RelativeSource AncestorType={x:Type views:GameResolutionPage}}}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <TextBlock Grid.Column="1"
                       Margin="8,0,0,0"
                       Text="{Binding CurrentResolutionValue, RelativeSource={RelativeSource AncestorType={x:Type views:GameResolutionPage}}}"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{Binding DataContext.AccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" />
        </Grid>
        <Grid Margin="0,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding RestoreAfterExitTitleText, RelativeSource={RelativeSource AncestorType={x:Type views:GameResolutionPage}}}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Margin="0,4,20,0"
                           Text="{Binding RestoreAfterExitDescriptionText, RelativeSource={RelativeSource AncestorType={x:Type views:GameResolutionPage}}}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
            <ToggleButton Grid.Column="1"
                          Style="{StaticResource ToggleSwitchStyle}"
                          IsChecked="{Binding DataContext.RestoreGameResolutionAfterExit, RelativeSource={RelativeSource AncestorType=Window}, Mode=TwoWay}" />
        </Grid>
        <Grid Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding CategoryFilterTitleText, RelativeSource={RelativeSource AncestorType={x:Type views:GameResolutionPage}}}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
                <TextBlock Margin="0,2,16,0"
                           Text="{Binding CategoryFilterDescriptionText, RelativeSource={RelativeSource AncestorType={x:Type views:GameResolutionPage}}}"
                           TextWrapping="Wrap"
                           FontSize="13"
                           Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
            </StackPanel>
            <ComboBox Grid.Column="1"
                      Width="180"
                      VerticalAlignment="Center"
                      Style="{StaticResource GameResComboBoxStyle}"
                      SelectedItem="{Binding SelectedCategory, RelativeSource={RelativeSource AncestorType={x:Type views:GameResolutionPage}}, Mode=TwoWay}"
                      ItemsSource="{Binding AvailableCategories, RelativeSource={RelativeSource AncestorType={x:Type views:GameResolutionPage}}}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding DisplayName}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
        <TextBlock Margin="0,20,0,0"
                   Text="{Binding ResolutionListIntroText, RelativeSource={RelativeSource AncestorType={x:Type views:GameResolutionPage}}}"
                   TextWrapping="Wrap"
                   FontSize="13"
                   Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
        <Border Style="{StaticResource StartsideSectionCardStyle}" Padding="16" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding FilteredShortcuts, RelativeSource={RelativeSource AncestorType={x:Type views:GameResolutionPage}}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <TextBlock Text="{Binding Path}"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
                            </StackPanel>
                            <ComboBox Grid.Column="1"
                                      Width="160"
                                      Margin="12,0,0,0"
                                      VerticalAlignment="Center"
                                      Style="{StaticResource GameResComboBoxStyle}"
                                      SelectedItem="{Binding GameResolution, Mode=TwoWay}"
                                      ItemsSource="{Binding SupportedResolutions, RelativeSource={RelativeSource AncestorType={x:Type views:GameResolutionPage}}}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- External games section — always visible below the regular shortcuts.
             Games started outside IconGrid (Battle.net, Steam, etc.) appear here
             so new users see them immediately without needing the category dropdown. -->
        <StackPanel x:Name="ExternalGamesSection" Margin="0,20,0,0"
                    Visibility="Collapsed">
            <TextBlock x:Name="ExternalGamesTitle"
                       Text="External games"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Border Style="{StaticResource StartsideSectionCardStyle}" Padding="16" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding ExternalGames, RelativeSource={RelativeSource AncestorType={x:Type views:GameResolutionPage}}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    <TextBlock Text="{Binding Path}"
                                               FontSize="12"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
                                </StackPanel>
                                <ComboBox Grid.Column="1"
                                          Width="160"
                                          Margin="12,0,0,0"
                                          VerticalAlignment="Center"
                                          Style="{StaticResource GameResComboBoxStyle}"
                                          SelectedItem="{Binding GameResolution, Mode=TwoWay}"
                                          ItemsSource="{Binding SupportedResolutions, RelativeSource={RelativeSource AncestorType={x:Type views:GameResolutionPage}}}" />
                                <Button Grid.Column="2"
                                        Width="28" Height="28"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Cursor="Hand"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                        ToolTip="Remove external game"
                                        Click="RemoveExternalGame_Click"
                                        Tag="{Binding Path}">
                                    <TextBlock Text="&#xE711;"
                                               FontFamily="Segoe Fluent Icons"
                                               FontSize="14"
                                               Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>