<UserControl x:Class="IconGrid.Views.HardwareHotspotSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:IconGrid.Helpers"
             xmlns:controls="clr-namespace:IconGrid.Controls"
             xmlns:views="clr-namespace:IconGrid.Views"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/Settings/Pages/HardwarePageResources.xaml" />
                <ResourceDictionary Source="/Views/TemplateGuidelines.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
                        <!-- GPU hotspot card -->
                        <Border Style="{StaticResource StartsideSectionCardStyle}"
                                helpers:DevInspector.Metadata="GPU hotspot card -> Views/Settings/Pages/HardwareHotspotSection.xaml">
                            <Expander Style="{StaticResource HardwareHeroExpanderStyle}"
                                      IsExpanded="False"
                                      helpers:DevInspector.Metadata="GPU hotspot card expander -> Views/Settings/Pages/HardwareHotspotSection.xaml">
                                <Expander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DataContext.GpuHotspotTitle, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                       Style="{StaticResource TemplateCardTitleStyle}"
                                                       Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <TextBlock Margin="0,8,0,0"
                                                       MaxWidth="680"
                                                       HorizontalAlignment="Left"
                                                       TextWrapping="Wrap"
                                                       Text="{Binding DataContext.GpuHotspotIntro, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                       Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1"
                                                   Text="&#xE70D;"
                                                   FontFamily="Segoe Fluent Icons"
                                                   FontSize="18"
                                                   Margin="24,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}, Converter={StaticResource HardwareExpanderAngleConverter}}" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Grid>
                                </Expander.Header>
                                <Expander.Content>
                                    <StackPanel>
                                        <Border Style="{StaticResource SettingsGroupCardStyle}">
                                            <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DataContext.GpuHotspotAlarmTitle, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                            <ToggleButton Grid.Column="1"
                                                          Style="{StaticResource ToggleSwitchStyle}"
                                                          IsChecked="{Binding DataContext.GpuHotspotAlarmEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}, Mode=TwoWay}" />
                                        </Grid>
                                        <TextBlock Margin="0,4,0,0"
                                                   MaxWidth="680"
                                                   HorizontalAlignment="Left"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Text="{Binding DataContext.GpuHotspotAlarmIntro, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                   Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                        <TextBlock Margin="0,12,0,0"
                                                   Text="{Binding DataContext.GpuHotspotAlarmThresholdTitle, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   MaxWidth="680"
                                                   HorizontalAlignment="Left"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Text="{Binding DataContext.GpuHotspotAlarmThresholdIntro, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                   Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                        <Grid Margin="0,8,0,0"
                                              IsEnabled="{Binding DataContext.GpuHotspotAlarmEnabled, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Slider Minimum="90"
                                                    Maximum="105"
                                                    TickFrequency="1"
                                                    SmallChange="1"
                                                    LargeChange="5"
                                                    IsSnapToTickEnabled="True"
                                                    Style="{StaticResource ModernSliderStyle}"
                                                    Value="{Binding DataContext.GpuHotspotAlarmThresholdC, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="12,0,0,0"
                                                       Width="52"
                                                       VerticalAlignment="Center"
                                                       TextAlignment="Right"
                                                       Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                       Text="{Binding DataContext.GpuHotspotAlarmThresholdC, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}, StringFormat={}{0} °C}" />
                                        </Grid>
                                        <TextBlock Margin="0,8,0,0"
                                                   MaxWidth="680"
                                                   HorizontalAlignment="Left"
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   Text="{Binding GpuHotspotStatusText}"
                                                   Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                        <TextBlock Margin="0,6,0,0"
                                                   MaxWidth="680"
                                                   HorizontalAlignment="Left"
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="#FFF0A030"
                                                   Text="{Binding GpuHotspotWarningText}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsGroupCardStyle}">
                                            <StackPanel>
                                        <TextBlock Margin="0,0,0,0"
                                                   MaxWidth="680"
                                                   HorizontalAlignment="Left"
                                                   TextWrapping="Wrap"
                                                   FontSize="13"
                                                   Text="{Binding DataContext.GamingOverlayHotspotAlertDemoIntro, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                        <controls:GamingOverlayPreview Margin="0,8,0,0" />
                                        <Button Margin="0,10,0,0"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource HardwareSecondaryButtonStyle}"
                                                Click="HotspotTestButton_Click"
                                                Content="{Binding DataContext.GamingOverlayHotspotAlertDemoButton, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsGroupCardStyle}">
                                            <StackPanel>
                                        <TextBlock Margin="0,0,0,0"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DataContext.GpuHotspotTrendTitle, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                   Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                        <Border Margin="0,8,0,0"
                                                Padding="10"
                                                HorizontalAlignment="Left"
                                                Background="#1B1B1B"
                                                BorderBrush="#3A3A3A"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <Grid Width="560" Height="120">
                                                <Canvas Width="560" Height="120" ClipToBounds="True">
                                                    <Polyline Points="{Binding HotspotTrendPoints}"
                                                              Stroke="#F0A030"
                                                              StrokeThickness="2" />
                                                    <Polyline Points="{Binding GpuTempTrendPoints}"
                                                              Stroke="#8A8A8A"
                                                              StrokeThickness="2" />
                                                </Canvas>
                                                <TextBlock Margin="2,0,0,0"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Top"
                                                           FontSize="10"
                                                           Foreground="#8A8A8A"
                                                           Text="110 °C" />
                                                <TextBlock Margin="2,0,0,0"
                                                           HorizontalAlignment="Left"
                                                           VerticalAlignment="Bottom"
                                                           FontSize="10"
                                                           Foreground="#8A8A8A"
                                                           Text="0 °C" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                            <TextBlock Text="●" Foreground="#F0A030" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Margin="4,0,16,0"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                       Text="{Binding DataContext.GpuHotspotTrendHotspotLabel, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                            <TextBlock Text="●" Foreground="#8A8A8A" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Margin="4,0,0,0"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                       Text="{Binding DataContext.GpuHotspotTrendGpuLabel, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                        </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SettingsGroupCardStyle}">
                                            <StackPanel>
                                        <Border Margin="0,0,0,0"
                                                Padding="12"
                                                HorizontalAlignment="Stretch"
                                                Background="#1B1B1B"
                                                BorderBrush="#3A3A3A"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <StackPanel>
                                                <TextBlock FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding DataContext.GpuHotspotRecordTitle, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                           Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                <TextBlock Margin="0,4,0,0"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding GpuHotspotRecordText}"
                                                           Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Margin="0,16,0,0"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding DataContext.GpuHotspotOtherHistoryTitle, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                   Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   MaxWidth="680"
                                                   HorizontalAlignment="Left"
                                                   TextWrapping="Wrap"
                                                   FontSize="12"
                                                   Text="{Binding DataContext.GpuHotspotHistoryHint, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}"
                                                   Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                        <Border Margin="0,6,0,0"
                                                Padding="10"
                                                Background="#1B1B1B"
                                                BorderBrush="#3A3A3A"
                                                BorderThickness="1"
                                                CornerRadius="6">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="82" />
                                                        <ColumnDefinition Width="66" />
                                                        <ColumnDefinition Width="55" />
                                                        <ColumnDefinition Width="82" />
                                                        <ColumnDefinition Width="88" />
                                                        <ColumnDefinition Width="100" />
                                                        <ColumnDefinition Width="58" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding DataContext.GpuHotspotColumnTime, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                    <TextBlock Grid.Column="1" FontSize="11" FontWeight="SemiBold" Text="{Binding DataContext.GpuHotspotColumnHotspot, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                    <TextBlock Grid.Column="2" FontSize="11" FontWeight="SemiBold" Text="{Binding DataContext.GpuHotspotColumnGpu, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                    <TextBlock Grid.Column="3" FontSize="11" FontWeight="SemiBold" Text="{Binding DataContext.GpuHotspotColumnCoreClock, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                    <TextBlock Grid.Column="4" FontSize="11" FontWeight="SemiBold" Text="{Binding DataContext.GpuHotspotColumnMemoryClock, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                    <TextBlock Grid.Column="5" FontSize="11" FontWeight="SemiBold" Text="{Binding DataContext.GpuHotspotColumnVram, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                    <TextBlock Grid.Column="6" FontSize="11" FontWeight="SemiBold" Text="{Binding DataContext.GpuHotspotColumnPower, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                    <TextBlock Grid.Column="7" FontSize="11" FontWeight="SemiBold" Text="{Binding DataContext.GpuHotspotColumnGame, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                </Grid>
                                                <ItemsControl ItemsSource="{Binding HotspotHistoryRows}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border BorderBrush="#2E2E2E" BorderThickness="0,1,0,0" Padding="0,5">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="82" />
                                                                        <ColumnDefinition Width="66" />
                                                                        <ColumnDefinition Width="55" />
                                                                        <ColumnDefinition Width="82" />
                                                                        <ColumnDefinition Width="88" />
                                                                        <ColumnDefinition Width="100" />
                                                                        <ColumnDefinition Width="58" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock FontSize="12" VerticalAlignment="Center" Text="{Binding TimeText}" Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                                    <TextBlock Grid.Column="1" FontSize="12" VerticalAlignment="Center" Text="{Binding HotspotText}" Foreground="{Binding DataContext.TopBarForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                                    <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center" Text="{Binding GpuText}" Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                                    <TextBlock Grid.Column="3" FontSize="12" VerticalAlignment="Center" Text="{Binding GpuClockText}" Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                                    <TextBlock Grid.Column="4" FontSize="12" VerticalAlignment="Center" Text="{Binding MemoryClockText}" Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                                    <TextBlock Grid.Column="5" FontSize="12" VerticalAlignment="Center" Text="{Binding VramText}" Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                                    <TextBlock Grid.Column="6" FontSize="12" VerticalAlignment="Center" Text="{Binding PowerText}" Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                                    <TextBlock Grid.Column="7" FontSize="12" VerticalAlignment="Center" Text="{Binding GameText}" TextTrimming="CharacterEllipsis" Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                                                </Grid>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="12"
                                                   Text="{Binding GpuHotspotHistoryNoDataText}"
                                                   Foreground="{Binding DataContext.SettingsSubtextForeground, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                        <Button Margin="0,8,0,0"
                                                HorizontalAlignment="Left"
                                                Style="{StaticResource HardwareProfileButtonStyle}"
                                                Click="ClearHotspotHistoryButton_Click"
                                                Content="{Binding DataContext.GpuHotspotHistoryClear, RelativeSource={RelativeSource AncestorType={x:Type views:HardwarePage}}}" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Expander.Content>
                            </Expander>
                        </Border>
</UserControl>
