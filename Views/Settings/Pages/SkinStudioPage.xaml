<UserControl x:Class="IconGrid.Views.SkinStudioPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:IconGrid.Views"
             mc:Ignorable="d"
             Background="Transparent"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Canvas grid: dark surface with 20 px lines (Photoshop-like work area). -->
        <DrawingBrush x:Key="CanvasGridBrush" TileMode="Tile"
                      Viewport="0,0,20,20" ViewportUnits="Absolute"
                      Viewbox="0,0,20,20" ViewboxUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#1B1D20" Geometry="M0,0 H20 V20 H0 Z" />
                    <GeometryDrawing>
                        <GeometryDrawing.Pen>
                            <Pen Brush="#26292D" Thickness="1" />
                        </GeometryDrawing.Pen>
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <LineGeometry StartPoint="0,0" EndPoint="20,0" />
                                <LineGeometry StartPoint="0,0" EndPoint="0,20" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="PanelTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#8B949E" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="ToolButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="#22252A" />
            <Setter Property="Foreground" Value="#D7DCE2" />
            <Setter Property="BorderBrush" Value="#33373D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="ToolRailButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E6EDF3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2A2F35" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3A424A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LibraryButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#22252A" />
            <Setter Property="Foreground" Value="#D7DCE2" />
            <Setter Property="BorderBrush" Value="#33373D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>

        <Style x:Key="LayerRowButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9AA4B0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Dark hover: the default WPF highlight is a light box that looks wrong here. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2A2F35" />
                                <Setter Property="Foreground" Value="#E6EDF3" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#3A424A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Dropdowns in the studio panels: the popup renders on the system (light) background, so a
            dark panel foreground made the items unreadable. Fixed light field + dark text.
        -->
        <Style x:Key="StudioComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="#E9ECEF" />
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="BorderBrush" Value="#9AA4B0" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Foreground" Value="#111111" />
                        <Setter Property="Padding" Value="6,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Left" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Menu bar above the canvas. The default WPF menu is light grey, so both the bar item and
            the drop-down rows get small dark templates that match the rest of Skin Studio.
        -->
        <Style x:Key="CanvasMenuBarItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#C9D1D9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                            <Border x:Name="Header" Background="Transparent" CornerRadius="4" Padding="10,3">
                                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                   Placement="Bottom" VerticalOffset="2"
                                   AllowsTransparency="True" StaysOpen="False" Focusable="False">
                                <Border Background="#1B1D20" BorderBrush="#2A2D31" BorderThickness="1"
                                        CornerRadius="4" Padding="4" MinWidth="190">
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Header" Property="Background" Value="#2A2F35" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CanvasMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="#C9D1D9" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="3" Padding="10,4">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#2A2F35" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#5C6672" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="180" />
            <ColumnDefinition Width="*" MinWidth="320" />
            <ColumnDefinition Width="5" />
            <ColumnDefinition Width="340" MinWidth="280" MaxWidth="720" />
        </Grid.ColumnDefinitions>

        <!-- ============ LEFT: module library ============ -->
        <Border Grid.Column="0" Background="#161719" BorderBrush="#2A2D31" BorderThickness="0,0,1,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="14">
                    <TextBlock Text="{Binding SkinStudioModuleLibraryTitleText}" Style="{StaticResource PanelTitleStyle}" />
                    <WrapPanel x:Name="LibraryPanel"
                               PreviewMouseLeftButtonDown="LibraryPanel_PreviewMouseLeftButtonDown"
                               PreviewMouseMove="LibraryPanel_PreviewMouseMove"
                               Background="Transparent">
                        <Button Style="{StaticResource LibraryButtonStyle}" Tag="clock" Click="AddModule_Click" Content="Clock" />
                        <Button Style="{StaticResource LibraryButtonStyle}" Tag="divider" Click="AddModule_Click" Content="Divider" />
                        <Button Style="{StaticResource LibraryButtonStyle}" Tag="ping" Click="AddModule_Click" Content="Ping" />
                        <Button Style="{StaticResource LibraryButtonStyle}" Tag="gauge:cpu" Click="AddModule_Click" Content="CPU" />
                        <Button Style="{StaticResource LibraryButtonStyle}" Tag="gauge:gpu" Click="AddModule_Click" Content="GPU" />
                        <Button Style="{StaticResource LibraryButtonStyle}" Tag="usage:cpu" Click="AddModule_Click" Content="CPU usage" />
                        <Button Style="{StaticResource LibraryButtonStyle}" Tag="usage:gpu" Click="AddModule_Click" Content="GPU usage" />
                        <Button Style="{StaticResource LibraryButtonStyle}" Tag="temp:cpu" Click="AddModule_Click" Content="CPU temp" />
                        <Button Style="{StaticResource LibraryButtonStyle}" Tag="temp:gpu" Click="AddModule_Click" Content="GPU temp" />
                        <Button Style="{StaticResource LibraryButtonStyle}" Tag="stat:gpuClock" Click="AddModule_Click" Content="GPU clock" />
                        <Button Style="{StaticResource LibraryButtonStyle}" Tag="stat:frameTime" Click="AddModule_Click" Content="FT" />
                        <Button Style="{StaticResource LibraryButtonStyle}" Tag="stat:fps" Click="AddModule_Click" Content="FPS" />
                        <Button Style="{StaticResource LibraryButtonStyle}" Tag="chrome:settings" Click="AddModule_Click"
                                Content="Settings" ToolTip="The gear button layer — moves into the selected group" />
                        <Button Style="{StaticResource LibraryButtonStyle}" Tag="chrome:close" Click="AddModule_Click"
                                Content="Close" ToolTip="The X button layer — moves into the selected group" />
                        <Button Style="{StaticResource LibraryButtonStyle}" Tag="chrome:background" Click="AddModule_Click"
                                Content="Background" ToolTip="The bar fill layer — moves into the selected group" />
                    </WrapPanel>

                    <Button Margin="0,10,0,0" Padding="10,6" HorizontalAlignment="Left"
                            Click="ToggleGauges_Click"
                            ToolTip="Splits combined CPU/GPU (Usage + Temp) modules into a usage meter and a temperature chip, or merges them back into one module"
                            Content="{Binding SkinStudioGaugeLayoutActionText}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Drag to resize the layers/properties panel. -->
        <GridSplitter Grid.Column="2"
                      Width="5"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#1E2126"
                      BorderBrush="#2A2D31"
                      BorderThickness="1,0,1,0"
                      ResizeBehavior="PreviousAndNext"
                      ResizeDirection="Columns"
                      ShowsPreview="True"
                      Cursor="SizeWE"
                      ToolTip="Drag to resize" />

        <!-- ============ CENTER: canvas with grid + guides ============ -->
        <Grid Grid.Column="1" Background="{StaticResource CanvasGridBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#141518" BorderBrush="#2A2D31" BorderThickness="0,0,0,1" Padding="6,3">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- File / Edit menu, like an editor. The group being designed sits on the right. -->
                    <Menu Grid.Column="0" Background="Transparent" BorderThickness="0" VerticalAlignment="Center">
                        <Menu.Resources>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource CanvasMenuBarItemStyle}" />
                            <Style TargetType="Separator">
                                <Setter Property="Background" Value="#2A2D31" />
                                <Setter Property="Height" Value="1" />
                                <Setter Property="Margin" Value="0,4" />
                            </Style>
                        </Menu.Resources>

                        <MenuItem Header="{Binding SkinStudioMenuFileText}"
                                  ItemContainerStyle="{StaticResource CanvasMenuItemStyle}">
                            <MenuItem Header="{Binding SkinStudioMenuSaveText}" Click="MenuSave_Click" />
                            <MenuItem Header="{Binding SkinStudioMenuNewGroupText}" Click="MenuNewGroup_Click" />
                            <Separator />
                            <MenuItem Header="{Binding SkinStudioMenuResetText}" Click="MenuReset_Click" />
                        </MenuItem>

                        <MenuItem Header="{Binding SkinStudioMenuEditText}"
                                  ItemContainerStyle="{StaticResource CanvasMenuItemStyle}">
                            <MenuItem Header="{Binding SkinStudioMenuUndoText}" Click="MenuUndo_Click"
                                      IsEnabled="{Binding CanUndoGamingOverlayLayout}" />
                            <MenuItem Header="{Binding SkinStudioMenuLockText}" Click="MenuLock_Click" />
                            <MenuItem Header="{Binding SkinStudioMenuDeleteText}" Click="MenuDelete_Click" />
                        </MenuItem>
                    </Menu>

                    <TextBlock x:Name="CanvasStatusText" Grid.Column="1" HorizontalAlignment="Right"
                               VerticalAlignment="Center" Margin="0,0,12,0"
                               Foreground="#7CFF6B" FontSize="11" />

                    <TextBlock Grid.Column="2" Text="{Binding GamingOverlayCanvasTitle}" Foreground="#C9D1D9"
                               FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0" />
                </Grid>
            </Border>

            <ScrollViewer Grid.Row="1"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalContentAlignment="Left"
                          VerticalContentAlignment="Top"
                          Background="Transparent">
                <Canvas x:Name="DesignCanvas" Width="1040" Height="620" Margin="20"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        AllowDrop="True"
                        DragOver="DesignCanvas_DragOver"
                        Drop="DesignCanvas_Drop">
                    <!-- Every layer group is its own bar with its own position: the standard overlay
                         stays visible while a new group is being built. The selected group gets the
                         bright guide frame; dragging its bar moves it. -->
                    <ItemsControl ItemsSource="{Binding GamingOverlayCanvasBars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Canvas />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Canvas.Left" Value="{Binding CanvasLeft}" />
                                <Setter Property="Canvas.Top" Value="{Binding CanvasTop}" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid x:Name="ItemRoot">
                                    <!-- The name is drawn above the bar without taking layout space,
                                         so a bar can sit flush with the top of the canvas. -->
                                    <TextBlock Text="{Binding Title}" Foreground="#B0438C" FontSize="11"
                                               VerticalAlignment="Top" Margin="0,-16,0,0" IsHitTestVisible="False" />
                                    <Border BorderBrush="#B0438C" BorderThickness="1" Background="#12B0438C"
                                            Visibility="{Binding GuideVisibility}" />
                                    <Border BorderBrush="#33373D" BorderThickness="1"
                                            Visibility="{Binding PlainFrameVisibility}" />
                                    <!-- The bar scales itself exactly like the live overlay, so the
                                         preview is 1:1 and sizes to the scaled content. The bar's
                                         DataContext is the view model (skin/dividers), while its
                                         bar-specific values come from this template's item. -->
                                    <views:GamingOverlayBar IsPreview="True"
                                                            MinWidth="80"
                                                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            BlocksSource="{Binding DataContext.Blocks, ElementName=ItemRoot}"
                                                            ChromeGroupId="{Binding DataContext.GroupId, ElementName=ItemRoot}"
                                                            BarHeight="{Binding DataContext.BarHeight, ElementName=ItemRoot}"
                                                            Width="{Binding DataContext.BarWidth, ElementName=ItemRoot}" />
                                    <!-- Transparent drag surface: click selects the group (in the
                                         layer list), dragging moves the whole bar. -->
                                    <Border Background="Transparent" Cursor="SizeAll"
                                            Tag="{Binding GroupId}"
                                            PreviewMouseLeftButtonDown="CanvasBar_MouseLeftButtonDown"
                                            PreviewMouseMove="CanvasBar_MouseMove"
                                            PreviewMouseLeftButtonUp="CanvasBar_MouseLeftButtonUp" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Vertical guide -->
                    <TextBlock Canvas.Left="960" Canvas.Top="150" Foreground="#B0438C" FontSize="11"
                               Text="Vertical — 48 x 400" />
                    <Border Canvas.Left="960" Canvas.Top="168" Width="48" Height="400"
                            BorderBrush="#B0438C" BorderThickness="1" Background="#12B0438C" />
                </Canvas>
            </ScrollViewer>

            <!-- Floating tool rail: drag the grip to move it anywhere over the canvas. -->
            <Canvas x:Name="ToolRailLayer" Grid.RowSpan="2">
                <Border x:Name="ToolRail"
                        Canvas.Left="12" Canvas.Top="86"
                        Width="56"
                        Background="#1B1D20"
                        BorderBrush="#2A2D31"
                        BorderThickness="1"
                        CornerRadius="7"
                        Padding="5,4">
                    <StackPanel>
                        <StackPanel x:Name="ToolRailHeader" Orientation="Horizontal">
                            <Thumb x:Name="ToolRailGrip"
                                   Width="26"
                                   Height="22"
                                   Cursor="SizeAll"
                                   ToolTip="Drag to move the toolbar (double-click to reset)"
                                   DragDelta="ToolRailGrip_DragDelta"
                                   MouseDoubleClick="ToolRailGrip_MouseDoubleClick">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="Transparent">
                                            <TextBlock Text="⠿" FontSize="16" Foreground="#6E7681"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                            <Button x:Name="ToolRailOrientationButton"
                                    Width="26" Height="22" Margin="2,0,0,0" Padding="0" FontSize="13"
                                    Background="Transparent" Foreground="#9AA4B0" BorderThickness="0"
                                    Cursor="Hand"
                                    Content="⇄"
                                    ToolTip="Switch between vertical and horizontal layout"
                                    Click="ToolRailOrientation_Click" />
                        </StackPanel>
                        <Rectangle Height="1" Fill="#2A2D31" Margin="2,2,2,8" Tag="separator" />

                        <StackPanel x:Name="ToolRailPanel" Orientation="Vertical">
                            <Button Style="{StaticResource ToolRailButtonStyle}" ToolTip="Move / Select" Content="✥" />
                            <Button Style="{StaticResource ToolRailButtonStyle}" ToolTip="Node edit" Content="⌗" />
                            <Rectangle Height="1" Fill="#2A2D31" Margin="2,6,2,8" Tag="separator" />
                            <Button Style="{StaticResource ToolRailButtonStyle}" ToolTip="Chamfer / radius" Content="◢" />
                            <Button Style="{StaticResource ToolRailButtonStyle}" ToolTip="Polygon maker" Content="⬠" />
                            <Rectangle Height="1" Fill="#2A2D31" Margin="2,6,2,8" Tag="separator" />
                            <Button Style="{StaticResource ToolRailButtonStyle}" ToolTip="Add text" Content="T" />
                            <Button Style="{StaticResource ToolRailButtonStyle}" ToolTip="Weld modules" Content="⛓" />
                            <Rectangle Height="1" Fill="#2A2D31" Margin="2,6,2,8" Tag="separator" />
                            <Button Style="{StaticResource ToolRailButtonStyle}" ToolTip="Reset to classic"
                                    Content="↺" Click="ResetBlueprint_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Canvas>
        </Grid>
        <!-- ============ RIGHT: layers + properties ============ -->
        <Border Grid.Column="3" Background="#141518" BorderBrush="#2A2D31" BorderThickness="1,0,0,0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding SkinStudioLayersTitleText}" FontSize="13" FontWeight="SemiBold" Foreground="#E6EDF3" />
                    <TextBlock Grid.Column="1" Text="☰" Foreground="#8B949E" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="88" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="90" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Read-only "blend mode" field: WPF has no real blend modes yet, but it must
                         look like a normal light dropdown with dark text. -->
                    <ComboBox Grid.Column="0" Style="{StaticResource StudioComboBoxStyle}"
                              IsHitTestVisible="False" Focusable="False">
                        <ComboBoxItem Content="Normal" IsSelected="True" />
                    </ComboBox>

                    <TextBlock Grid.Column="2" Text="Opacity:" Foreground="#C9D1D9" FontSize="11"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <Slider x:Name="OpacitySlider" Grid.Column="3" VerticalAlignment="Center"
                            Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True"
                            ValueChanged="OpacitySlider_ValueChanged" />
                    <TextBlock x:Name="OpacityValueText" Grid.Column="4" Text="100%" Foreground="#C9D1D9" FontSize="11"
                               VerticalAlignment="Center" Margin="6,0,0,0" />
                </Grid>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Layer:" Foreground="#C9D1D9" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Style="{StaticResource LayerRowButtonStyle}" Content="↶" ToolTip="Undo last layer change"
                            Click="UndoLayer_Click" IsEnabled="{Binding CanUndoGamingOverlayLayout}" Foreground="#C9D1D9" />
                    <Button Style="{StaticResource LayerRowButtonStyle}" Content="📁" ToolTip="Make group"
                            Click="NewGroup_Click" Foreground="#C9D1D9" />
                    <Button Style="{StaticResource LayerRowButtonStyle}" Tag="clock" Click="AddModule_Click" Content="＋"
                            ToolTip="Add module" Foreground="#C9D1D9" />
                    <Button x:Name="DeleteLayerButton" Style="{StaticResource LayerRowButtonStyle}" Content="🗑"
                            ToolTip="Delete layer or group"
                            Click="DeleteSelectedModule_Click" Foreground="#C9D1D9" />
                    <Button Style="{StaticResource LayerRowButtonStyle}" Content="🔒" ToolTip="Lock / unlock the selected layer or group"
                            Click="ToggleLock_Click" Foreground="#C9D1D9" />
                </StackPanel>
                <Grid Grid.Row="3">
                <ListBox x:Name="LayersList"
                         Background="Transparent" BorderThickness="0" Foreground="#E6EDF3"
                         ItemsSource="{Binding GamingOverlayLayerItems}"
                         SelectionChanged="LayersList_SelectionChanged"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="LayersList_PreviewMouseLeftButtonDown"
                         PreviewMouseMove="LayersList_PreviewMouseMove"
                         DragOver="LayersList_DragOver"
                         DragLeave="LayersList_DragLeave"
                         Drop="LayersList_Drop"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#E6EDF3" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" Background="Transparent" BorderBrush="Transparent"
                                                BorderThickness="1" Padding="4,3">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#1F2429" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="#123A5A" />
                                                <Setter TargetName="Row" Property="BorderBrush" Value="#2FA8D8" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid x:Name="RowRoot" Margin="0,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="EyeButton" Style="{StaticResource LayerRowButtonStyle}" Tag="{Binding}"
                                        Click="ToggleModuleHidden_Click" ToolTip="Show / hide">
                                    <TextBlock x:Name="EyeGlyph" Text="👁" FontSize="12" />
                                </Button>
                                <StackPanel x:Name="NamePanel" Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center">
                                    <TextBlock x:Name="FolderGlyph" Text="📁" FontSize="12" Margin="0,0,4,0"
                                               VerticalAlignment="Center" Visibility="Collapsed" />
                                    <TextBlock x:Name="LayerNameText" Text="{Binding DisplayName}"
                                               Foreground="#E6EDF3" VerticalAlignment="Center" FontSize="12" />
                                    <TextBlock x:Name="LockGlyph" Text="🔒" FontSize="10" Margin="6,0,0,0"
                                               VerticalAlignment="Center" Visibility="Collapsed" />
                                </StackPanel>
                                <TextBlock x:Name="DragHandle" Grid.Column="2" Text="☰" Foreground="#5C6672" FontSize="11"
                                           VerticalAlignment="Center" Margin="6,0,0,0" />
                                <Button x:Name="ChevronButton" Grid.Column="2" Visibility="Collapsed"
                                        Style="{StaticResource LayerRowButtonStyle}" Tag="{Binding}"
                                        Click="ToggleGroupCollapsed_Click" ToolTip="Expand / collapse group">
                                    <TextBlock x:Name="ChevronGlyph" FontSize="11" />
                                </Button>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                    <Setter TargetName="EyeGlyph" Property="Opacity" Value="0.25" />
                                </DataTrigger>
                                <!-- Group rows are folders: folder icon, bold name, no indent, chevron. -->
                                <DataTrigger Binding="{Binding IsGroupLayer}" Value="True">
                                    <Setter TargetName="FolderGlyph" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="LayerNameText" Property="FontWeight" Value="Bold" />
                                    <Setter TargetName="NamePanel" Property="Margin" Value="2,0,0,0" />
                                    <Setter TargetName="DragHandle" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="ChevronButton" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <!-- Modules inside a folder are indented, like Photoshop's layer tree. -->
                                <DataTrigger Binding="{Binding IsGroupLayer}" Value="False">
                                    <Setter TargetName="NamePanel" Property="Margin" Value="24,0,0,0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCollapsed}" Value="True">
                                    <Setter TargetName="ChevronGlyph" Property="Text" Value="▸" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsCollapsed}" Value="False">
                                    <Setter TargetName="ChevronGlyph" Property="Text" Value="▾" />
                                </DataTrigger>
                                <!-- A hidden group dims all of its rows, not just its own folder row. -->
                                <DataTrigger Binding="{Binding IsGroupHidden}" Value="True">
                                    <Setter TargetName="RowRoot" Property="Opacity" Value="0.45" />
                                </DataTrigger>
                                <!-- Locked rows show a padlock next to the name. -->
                                <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                    <Setter TargetName="LockGlyph" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                    <!-- Light-blue insertion line shown while dragging a layer. -->
                    <Border x:Name="LayerDropIndicator"
                            Height="2"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Stretch"
                            Margin="24,0,8,0"
                            Background="#2FA8D8"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                        <Border.RenderTransform>
                            <TranslateTransform x:Name="LayerDropIndicatorTransform" />
                        </Border.RenderTransform>
                    </Border>
                </Grid>

                <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" MaxHeight="430"
                              Padding="0,0,10,0" Margin="0,10,0,0">
                    <StackPanel Margin="0,0,2,0">
                        <TextBlock Text="{Binding SkinStudioPropertiesTitleText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="#E6EDF3" Margin="0,0,0,8" />
                        <TextBlock x:Name="SelectedModuleText" Foreground="#8B949E" FontSize="12" Text="—" />
                        <StackPanel x:Name="GenericColorSection">
                            <TextBlock Margin="0,10,0,4" Foreground="#8B949E" FontSize="11" Text="Label" />
                            <TextBox x:Name="PropLabelBox" Padding="6,4" Background="#1E2126" Foreground="#D7DCE2"
                                     BorderBrush="#33373D" LostFocus="PropLabelBox_LostFocus" />
                            <TextBlock Margin="0,10,0,4" Foreground="#8B949E" FontSize="11" Text="Colour (hex)" />
                            <TextBox x:Name="PropColorBox" Padding="6,4" Background="#1E2126" Foreground="#D7DCE2"
                                     BorderBrush="#33373D" LostFocus="PropColorBox_LostFocus" />
                        </StackPanel>

                        <!-- Layer groups: rename a folder, or move the selected module into one. -->
                        <StackPanel x:Name="GroupNameSection" Visibility="Collapsed" Margin="0,14,0,0">
                            <Border Height="1" Background="#2A2D31" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding SkinStudioGroupTitleText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#E6EDF3" Margin="0,0,0,6" />
                            <TextBlock Margin="0,0,0,4" Foreground="#8B949E" FontSize="11" Text="{Binding SkinStudioGroupNameLabelText}" />
                            <TextBox x:Name="GroupNameBox" Padding="6,4" Background="#1E2126" Foreground="#D7DCE2"
                                     BorderBrush="#33373D" LostFocus="GroupNameBox_LostFocus" />

                            <!-- The group's own bar: this is the base template you build inside. -->
                            <TextBlock Margin="0,10,0,4" Foreground="#8B949E" FontSize="11"
                                       Text="Bar size (width x height, 0 = auto)" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="GroupBarWidthBox" Grid.Column="0" Padding="6,4"
                                         Background="#1E2126" Foreground="#D7DCE2" BorderBrush="#33373D"
                                         LostFocus="GroupBarSize_LostFocus" />
                                <TextBox x:Name="GroupBarHeightBox" Grid.Column="2" Padding="6,4"
                                         Background="#1E2126" Foreground="#D7DCE2" BorderBrush="#33373D"
                                         LostFocus="GroupBarSize_LostFocus" />
                                <Button Grid.Column="4" Padding="8,2" Content="Apply"
                                        Click="GroupBarSize_Click" ToolTip="Use this size for the group's bar" />
                            </Grid>
                        </StackPanel>

                        <StackPanel x:Name="ModuleGroupSection" Visibility="Collapsed" Margin="0,12,0,0">
                            <TextBlock Margin="0,0,0,4" Foreground="#8B949E" FontSize="11" Text="{Binding SkinStudioModuleGroupLabelText}" />
                            <ComboBox x:Name="ModuleGroupBox" Style="{StaticResource StudioComboBoxStyle}"
                                      DisplayMemberPath="Name"
                                      SelectionChanged="ModuleGroupBox_SelectionChanged" />
                        </StackPanel>

                        <StackPanel x:Name="GaugeSection" Visibility="Collapsed" Margin="0,14,0,0">
                            <Border Height="1" Background="#2A2D31" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding SkinStudioGaugeTitleText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#E6EDF3" Margin="0,0,0,6" />

                            <TextBlock Margin="0,0,0,4" Foreground="#8B949E" FontSize="11" Text="{Binding SkinStudioMeterStyleLabelText}" />
                            <ComboBox x:Name="MeterStyleBox" Style="{StaticResource StudioComboBoxStyle}"
                                      SelectionChanged="MeterStyleBox_SelectionChanged">
                                <ComboBoxItem Content="Bar" Tag="bar" />
                                <ComboBoxItem Content="Ring" Tag="ring" />
                                <ComboBoxItem Content="Segments" Tag="segments" />
                                <ComboBoxItem Content="Text" Tag="text" />
                            </ComboBox>

                            <TextBlock Margin="0,8,0,4" Foreground="#8B949E" FontSize="11" Text="{Binding SkinStudioMeterColorLabelText}" />
                            <TextBox x:Name="MeterColorBox" Padding="6,4" Background="#1E2126" Foreground="#D7DCE2"
                                     BorderBrush="#33373D" LostFocus="MeterColorBox_LostFocus" />

                            <TextBlock Margin="0,8,0,4" Foreground="#8B949E" FontSize="11" Text="{Binding SkinStudioMeterSizeLabelText}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MeterWidthBox" Grid.Column="0" Padding="6,4" Background="#1E2126"
                                         Foreground="#D7DCE2" BorderBrush="#33373D" LostFocus="MeterWidthBox_LostFocus" />
                                <TextBox x:Name="MeterHeightBox" Grid.Column="2" Padding="6,4" Background="#1E2126"
                                         Foreground="#D7DCE2" BorderBrush="#33373D" LostFocus="MeterHeightBox_LostFocus" />
                            </Grid>

                            <CheckBox x:Name="ShowTempBox" Margin="0,10,0,0" Foreground="#C9D1D9" Click="GaugeToggle_Click"
                                      Tag="showTemp" Content="{Binding SkinStudioMeterTempLabelText}" />
                            <CheckBox x:Name="ShowPercentBox" Margin="0,6,0,0" Foreground="#C9D1D9" Click="GaugeToggle_Click"
                                      Tag="showPercent" Content="{Binding SkinStudioMeterPercentLabelText}" />
                            <CheckBox x:Name="ShowGridBox" Margin="0,6,0,0" Foreground="#C9D1D9" Click="GaugeToggle_Click"
                                      Tag="hasGrid" Content="{Binding SkinStudioMeterGridLabelText}" />
                        </StackPanel>

                        <!-- Overlay chrome (settings / close button) styling. -->
                        <StackPanel x:Name="ChromeSection" Visibility="Collapsed" Margin="0,14,0,0">
                            <Border Height="1" Background="#2A2D31" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding SkinStudioButtonTitleText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#E6EDF3" Margin="0,0,0,6" />
                            <TextBlock Margin="0,0,0,4" Foreground="#8B949E" FontSize="11" Text="{Binding SkinStudioButtonIconLabelText}" />
                            <TextBox x:Name="ButtonIconBox" Padding="6,4" Background="#1E2126" Foreground="#D7DCE2"
                                     BorderBrush="#33373D" LostFocus="ButtonIconBox_LostFocus" />
                            <TextBlock Margin="0,8,0,4" Foreground="#8B949E" FontSize="11" Text="{Binding SkinStudioButtonSizeLabelText}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="ButtonWidthBox" Grid.Column="0" Padding="6,4" Background="#1E2126"
                                         Foreground="#D7DCE2" BorderBrush="#33373D" LostFocus="ButtonWidthBox_LostFocus" />
                                <TextBox x:Name="ButtonHeightBox" Grid.Column="2" Padding="6,4" Background="#1E2126"
                                         Foreground="#D7DCE2" BorderBrush="#33373D" LostFocus="ButtonHeightBox_LostFocus" />
                            </Grid>
                            <TextBlock Margin="0,8,0,4" Foreground="#8B949E" FontSize="11" Text="{Binding SkinStudioButtonBorderLabelText}" />
                            <TextBox x:Name="ButtonBorderBox" Padding="6,4" Background="#1E2126" Foreground="#D7DCE2"
                                     BorderBrush="#33373D" LostFocus="ButtonBorderBox_LostFocus" />
                            <TextBlock Margin="0,8,0,4" Foreground="#8B949E" FontSize="11" Text="{Binding SkinStudioButtonBorderColorLabelText}" />
                            <TextBox x:Name="ButtonBorderColorBox" Padding="6,4" Background="#1E2126" Foreground="#D7DCE2"
                                     BorderBrush="#33373D" LostFocus="ButtonBorderColorBox_LostFocus" />
                            <TextBlock Margin="0,8,0,4" Foreground="#8B949E" FontSize="11" Text="{Binding SkinStudioButtonBackgroundLabelText}" />
                            <TextBox x:Name="ButtonBackgroundBox" Padding="6,4" Background="#1E2126" Foreground="#D7DCE2"
                                     BorderBrush="#33373D" LostFocus="ButtonBackgroundBox_LostFocus" />
                        </StackPanel>

                        <!-- Overlay background (the bar itself) — edits the skin tokens. -->
                        <StackPanel x:Name="BackgroundSection" Visibility="Collapsed" Margin="0,14,0,0">
                            <Border Height="1" Background="#2A2D31" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding SkinStudioBackgroundTitleText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#E6EDF3" Margin="0,0,0,6" />
                            <TextBlock Margin="0,0,0,4" Foreground="#8B949E" FontSize="11" Text="{Binding SkinStudioBackgroundColorLabelText}" />
                            <TextBox x:Name="BackgroundColorBox" Padding="6,4" Background="#1E2126" Foreground="#D7DCE2"
                                     BorderBrush="#33373D" LostFocus="BackgroundColorBox_LostFocus" />
                            <TextBlock Margin="0,8,0,4" Foreground="#8B949E" FontSize="11" Text="{Binding SkinStudioBackgroundRadiusLabelText}" />
                            <TextBox x:Name="BackgroundRadiusBox" Padding="6,4" Background="#1E2126" Foreground="#D7DCE2"
                                     BorderBrush="#33373D" LostFocus="BackgroundRadiusBox_LostFocus" />
                        </StackPanel>
                        <!-- Code snippet for the selected module: a JSON property patch. -->
                        <StackPanel x:Name="SnippetSection" Margin="0,14,0,0">
                            <Border Height="1" Background="#2A2D31" Margin="0,0,0,10" />
                            <TextBlock Text="{Binding SkinStudioSnippetTitleText}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="#E6EDF3" Margin="0,0,0,6" />
                            <TextBlock Text="{Binding SkinStudioSnippetHintText}" Foreground="#8B949E" FontSize="10"
                                       TextWrapping="Wrap" Margin="0,0,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox x:Name="SnippetLibraryBox" Style="{StaticResource StudioComboBoxStyle}"
                                          DisplayMemberPath="Title"
                                          SelectionChanged="SnippetLibraryBox_SelectionChanged" />
                                <Button Grid.Column="1" Margin="6,0,0,0" Padding="10,2" Click="SnippetInsert_Click"
                                        Content="{Binding SkinStudioSnippetInsertText}" />
                            </Grid>
                            <TextBox x:Name="SnippetEditorBox" Margin="0,8,0,0" Padding="6,4" Height="96"
                                     Background="#1E2126" Foreground="#C9D1D9" BorderBrush="#33373D"
                                     FontFamily="Consolas" FontSize="11" AcceptsReturn="True" AcceptsTab="True"
                                     TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                     HorizontalScrollBarVisibility="Auto" />
                            <WrapPanel Margin="0,8,0,0">
                                <Button Padding="12,4" Margin="0,0,6,4" Click="SnippetApply_Click"
                                        Content="{Binding SkinStudioSnippetApplyText}" />
                                <Button Padding="12,4" Margin="0,0,6,4" Click="SnippetReset_Click"
                                        Content="{Binding SkinStudioSnippetResetText}" />
                            </WrapPanel>
                            <TextBlock x:Name="SnippetStatusText" Margin="0,6,0,0" FontSize="11" Foreground="#8B949E"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Niveau B: a free XAML template that replaces this module's built-in look. -->
                        <Expander x:Name="TemplateSection" Margin="0,12,0,0" Foreground="#E6EDF3" IsExpanded="False"
                                  Header="{Binding SkinStudioTemplateTitleText}">
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="{Binding SkinStudioTemplateHintText}" Foreground="#8B949E"
                                           FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6" />
                                <TextBox x:Name="TemplateEditorBox" Height="140" Padding="6,4"
                                         Background="#1E2126" Foreground="#C9D1D9" BorderBrush="#33373D"
                                         FontFamily="Consolas" FontSize="11" AcceptsReturn="True" AcceptsTab="True"
                                         TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto" />
                                <!-- Buttons: full-width "load code" on top, then Apply / Remove side by side,
                                     so the row stays even even when the panel is dragged narrow. -->
                                <Button Margin="0,8,0,6" Padding="10,4" HorizontalAlignment="Stretch"
                                        Click="TemplateLoadCode_Click"
                                        Content="{Binding SkinStudioTemplateLoadCodeText}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Padding="10,4" HorizontalAlignment="Stretch"
                                            Click="TemplateApply_Click"
                                            Content="{Binding SkinStudioTemplateApplyText}" />
                                    <Button Grid.Column="2" Padding="10,4" HorizontalAlignment="Stretch"
                                            Click="TemplateReset_Click"
                                            Content="{Binding SkinStudioTemplateResetText}" />
                                </Grid>
                                <TextBlock x:Name="TemplateStatusText" Margin="0,6,0,0" FontSize="11"
                                           Foreground="#8B949E" TextWrapping="Wrap" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
