<Window x:Class="IconGrid.Views.BenchmarkRunWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding FastCopyBenchmarkTitle}"
        Height="420"
        Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#F2F3F6"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Views/TemplateGuidelines.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="BenchmarkButtonStyle" TargetType="Button" BasedOn="{StaticResource TemplateActionButtonStyle}">
                <Setter Property="MinWidth" Value="88" />
                <Setter Property="Margin" Value="8,0,0,0" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Border Style="{StaticResource StartsideSectionCardStyle}" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Style="{StaticResource TemplateCardTitleStyle}"
                       Text="{Binding FastCopyBenchmarkTitle}" />

            <TextBlock Grid.Row="1"
                       Name="StatusText"
                       Style="{StaticResource TemplateHeroBodyStyle}"
                       Margin="0,8,0,0"
                       Text="{Binding FastCopyBenchmarkPreparing}" />

            <ProgressBar Grid.Row="2"
                         Name="ProgressBar"
                         Margin="0,12,0,0"
                         Height="8"
                         Minimum="0"
                         Maximum="100" />

            <ListBox Grid.Row="3"
                     Name="LogBox"
                     Margin="0,12,0,0"
                     Background="{StaticResource StartsideCardFill}"
                     Foreground="White"
                     BorderThickness="1"
                     BorderBrush="#3A3A3A"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="2,1" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Foreground" Value="White" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Style="{StaticResource BenchmarkButtonStyle}"
                        Content="{Binding FastCopyCancelButton}"
                        Click="Stop_Click" />
                <Button Style="{StaticResource BenchmarkButtonStyle}"
                        Content="{Binding FastCopyCloseButton}"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>