<UserControl x:Class="IconGrid.Controls.GamingOverlayPreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:IconGrid.Views"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True">
    <!--
        Read-only preview of the real gaming overlay.
        The host supplies MainViewModel through the Window DataContext; the
        overlay bar itself remains purely visual and never receives input here.
    -->
    <Border Padding="12"
            HorizontalAlignment="Stretch"
            MaxHeight="140"
            Background="#242424"
            BorderBrush="#3A3A3A"
            BorderThickness="1"
            CornerRadius="6"
            ClipToBounds="True"
            IsHitTestVisible="False">
        <views:GamingOverlayBar IsPreview="True"
                               DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
    </Border>
</UserControl>
