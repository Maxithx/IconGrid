<UserControl x:Class="IconGrid.Controls.LauncherMonitorRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:IconGrid.Helpers"
             xmlns:converters="clr-namespace:IconGrid.Helpers.Converters">
    <UserControl.Resources>
        <converters:ZeroToAutoWidthConverter x:Key="ZeroToAutoWidthConverter" />
        <helpers:InverseBoolConverter x:Key="InverseBoolConverter" />
        <helpers:PingSeverityToBrushConverter x:Key="PingSeverityBrush" />
        <helpers:PercentToHeightConverter x:Key="PercentToHeightConverter" />
        <converters:DoubleToLeftMarginConverter x:Key="DoubleToLeftMarginConverter" />
        <helpers:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <SolidColorBrush x:Key="MonitorHighPingColor" Color="#FFF87171" />

        <Style x:Key="MonitorTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsLightTheme, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Foreground" Value="#111" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NetworkMonitorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource MonitorTextStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SystemMonitor.IsHighPing}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource MonitorHighPingColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="MonitorDividerStyle" TargetType="TextBlock" BasedOn="{StaticResource MonitorTextStyle}">
            <Setter Property="Text" Value="|" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.4" />
        </Style>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="0"
                helpers:DevInspector.Metadata="Monitor row → Controls/LauncherMonitorRow.xaml">
        <!-- Ping dot -->
        <Border Width="10" Height="10" CornerRadius="5" VerticalAlignment="Center"
                Margin="0"
                Background="{Binding SystemMonitor.PingSeverityLevel, Converter={StaticResource PingSeverityBrush}}" />
        <!-- Net -->
        <TextBlock Style="{StaticResource NetworkMonitorTextStyle}"
                   Width="64"
                   Margin="{Binding MonitorPingToNetGap, Converter={StaticResource DoubleToLeftMarginConverter}}"
                   ToolTipService.IsEnabled="{Binding ShowDevOverlay, Converter={StaticResource InverseBoolConverter}}">
            <Run Text="{Binding MonitorNetworkLabel, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding SystemMonitor.NetworkStatus, Mode=OneWay}" />
        </TextBlock>
        <!-- Divider 0 -->
        <TextBlock Style="{StaticResource MonitorDividerStyle}"
                   Visibility="{Binding MonitorDivider0Visible, Converter={StaticResource BoolToVisibilityConverter}}"
                   Margin="{Binding MonitorDividerGap, Converter={StaticResource DoubleToLeftMarginConverter}}" />
        <!-- Download: label (auto), value (bindable width), unit (auto). Value-width slider controls stability. -->
        <StackPanel Orientation="Horizontal"
                    Margin="{Binding MonitorNetToDownloadGap, Converter={StaticResource DoubleToLeftMarginConverter}}"
                    ToolTipService.IsEnabled="{Binding ShowDevOverlay, Converter={StaticResource InverseBoolConverter}}">
            <TextBlock Style="{StaticResource MonitorTextStyle}" VerticalAlignment="Center"
                       Text="{Binding MonitorDownloadLabel, Mode=OneWay,StringFormat={}{0}: }" />
            <TextBlock Style="{StaticResource MonitorTextStyle}" VerticalAlignment="Center"
                       Margin="{Binding MonitorDownloadLabelToValueGap, Converter={StaticResource DoubleToLeftMarginConverter}}"
                       Width="{Binding MonitorDownloadValueWidth, Converter={StaticResource ZeroToAutoWidthConverter}}"
                       FontFamily="Consolas"
                       TextAlignment="Left"
                       Text="{Binding SystemMonitor.DownloadValue, Mode=OneWay}" />
            <TextBlock Style="{StaticResource MonitorTextStyle}" VerticalAlignment="Center"
                       Margin="{Binding MonitorDownloadValueToUnitGap, Converter={StaticResource DoubleToLeftMarginConverter}}"
                       Text="{Binding SystemMonitor.DownloadUnit, Mode=OneWay}" />
        </StackPanel>
        <!-- Divider 1 -->
        <TextBlock Style="{StaticResource MonitorDividerStyle}"
                   Visibility="{Binding MonitorDivider1Visible, Converter={StaticResource BoolToVisibilityConverter}}"
                   Margin="{Binding MonitorDividerGap, Converter={StaticResource DoubleToLeftMarginConverter}}" />
        <!-- Upload: label (auto), value (bindable width), unit (auto). Value-width slider controls stability. -->
        <StackPanel Orientation="Horizontal"
                    Margin="{Binding MonitorDownloadToUploadGap, Converter={StaticResource DoubleToLeftMarginConverter}}"
                    ToolTipService.IsEnabled="{Binding ShowDevOverlay, Converter={StaticResource InverseBoolConverter}}">
            <TextBlock Style="{StaticResource MonitorTextStyle}" VerticalAlignment="Center"
                       Text="{Binding MonitorUploadLabel, Mode=OneWay,StringFormat={}{0}: }" />
            <TextBlock Style="{StaticResource MonitorTextStyle}" VerticalAlignment="Center"
                       Margin="{Binding MonitorUploadLabelToValueGap, Converter={StaticResource DoubleToLeftMarginConverter}}"
                       Width="{Binding MonitorUploadValueWidth, Converter={StaticResource ZeroToAutoWidthConverter}}"
                       FontFamily="Consolas"
                       TextAlignment="Left"
                       Text="{Binding SystemMonitor.UploadValue, Mode=OneWay}" />
            <TextBlock Style="{StaticResource MonitorTextStyle}" VerticalAlignment="Center"
                       Margin="{Binding MonitorUploadValueToUnitGap, Converter={StaticResource DoubleToLeftMarginConverter}}"
                       Text="{Binding SystemMonitor.UploadUnit, Mode=OneWay}" />
        </StackPanel>
        <!-- Divider 2 -->
        <TextBlock Style="{StaticResource MonitorDividerStyle}"
                   Visibility="{Binding MonitorDivider2Visible, Converter={StaticResource BoolToVisibilityConverter}}"
                   Margin="{Binding MonitorDividerGap, Converter={StaticResource DoubleToLeftMarginConverter}}" />
        <!-- CPU temp -->
        <TextBlock Style="{StaticResource MonitorTextStyle}"
                   Margin="{Binding MonitorUploadToCpuGap, Converter={StaticResource DoubleToLeftMarginConverter}}"
                   TextAlignment="Left"
                   ToolTipService.IsEnabled="{Binding ShowDevOverlay, Converter={StaticResource InverseBoolConverter}}">
            <Run Text="{Binding MonitorCpuLabel, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding SystemMonitor.CpuTemp, Mode=OneWay}" />
        </TextBlock>
        <!-- CPU bar -->
        <Border Width="12" Height="14" Margin="{Binding MonitorCpuBarGap, Converter={StaticResource DoubleToLeftMarginConverter}}"
                Background="#22000000" BorderBrush="#80FFFFFF" BorderThickness="1" CornerRadius="2"
                ToolTip="{Binding SystemMonitor.CpuUsage}">
            <Rectangle Fill="#22C55E" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2"
                       Height="{Binding SystemMonitor.CpuUsagePercent, Converter={StaticResource PercentToHeightConverter}, ConverterParameter=12}" />
        </Border>
        <!-- Divider 3 -->
        <TextBlock Style="{StaticResource MonitorDividerStyle}"
                   Visibility="{Binding MonitorDivider3Visible, Converter={StaticResource BoolToVisibilityConverter}}"
                   Margin="{Binding MonitorDividerGap, Converter={StaticResource DoubleToLeftMarginConverter}}" />
        <!-- GPU temp -->
        <TextBlock Style="{StaticResource MonitorTextStyle}"
                   Margin="{Binding MonitorCpuToGpuGap, Converter={StaticResource DoubleToLeftMarginConverter}}"
                   TextAlignment="Left"
                   ToolTip="{Binding SystemMonitor.GpuName}"
                   ToolTipService.IsEnabled="{Binding ShowDevOverlay, Converter={StaticResource InverseBoolConverter}}">
            <Run Text="{Binding MonitorGpuLabel, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding SystemMonitor.GpuTemp, Mode=OneWay}" />
        </TextBlock>
        <!-- GPU bar -->
        <Border Width="12" Height="14" Margin="{Binding MonitorGpuBarGap, Converter={StaticResource DoubleToLeftMarginConverter}}"
                Background="#22000000" BorderBrush="#80FFFFFF" BorderThickness="1" CornerRadius="2"
                ToolTip="{Binding SystemMonitor.GpuUsage}">
            <Rectangle Fill="#A855F7" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" RadiusX="2" RadiusY="2"
                       Height="{Binding SystemMonitor.GpuUsagePercent, Converter={StaticResource PercentToHeightConverter}, ConverterParameter=12}" />
        </Border>
    </StackPanel>
</UserControl>